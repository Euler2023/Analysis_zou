\subsubsection*{6) 双曲函数}

\begin{mydef*}{}

	函数
	\[
	x\longmapsto\operatorname{sh}x\triangleq\frac{e^x-e^{-x}}2,\quad x\in\R;
	\]
	\[
	x\longmapsto\operatorname{ch}x\triangleq\frac{e^x+e^{-x}}2,\quad x\in\R;
	\]
	\[
	x\longmapsto\operatorname{th}x\triangleq\frac{e^x-e^{-x}}{e^x+e^{-x}},\quad x\in\R;
	\]
	\[
	x\longmapsto\operatorname{cth}x\triangleq\frac{e^x+e^{-x}}{e^x-e^{-x}},\quad x\in\R-\{0\}
	\]
	分别称为双曲正弦函数、双曲余弦函数、双曲正切函数与双曲余切函数。

\end{mydef*}

这些函数的基本性质可由下面两个定理来表述。

\begin{mythm}{}{hyperbolic-identities}

	1) 双曲正弦、双曲余弦、双曲正切、双曲余切函数都是在各自定义域上的连续函数。

	2) 下述等式成立：
	\[
	\operatorname{ch}^2x-\operatorname{sh}^2x=1,\qquad 1-\operatorname{th}^2x=\frac1{\operatorname{ch}^2x},
	\]
	\[
	\operatorname{cth}^2x-1=\frac1{\operatorname{sh}^2x},
	\]
	\[
	\operatorname{sh}(-x)=-\operatorname{sh}x,\qquad\operatorname{ch}(-x)=\operatorname{ch}x,
	\]
	\[
	\operatorname{th}(-x)=-\operatorname{th}x,\qquad\operatorname{cth}(-x)=-\operatorname{cth}x,
	\]
	\[
	\operatorname{sh}(x+y)=\operatorname{sh}x\operatorname{ch}y+\operatorname{ch}x\operatorname{sh}y,
	\]
	\[
	\operatorname{ch}(x+y)=\operatorname{ch}x\operatorname{ch}y+\operatorname{sh}x\operatorname{sh}y.
	\]

\end{mythm}

\begin{proof}

	性质 1) 直接由双曲函数的定义推出，2) 的各等式直接计算即可验证。

\end{proof}

\begin{mythm}{}{hyperbolic-monotonicity}

	关于双曲函数的单调性及其图形，我们有下述各结论：

	\begin{enumerate}[label=\arabic*)]
		\item 双曲正弦函数在 \(\R\) 上严格单调上升，并且
		\[
		\lim_{x\to-\infty}\operatorname{sh}x=-\infty,\qquad\lim_{x\to+\infty}\operatorname{sh}x=+\infty.
		\]
		它的图形关于原点对称，无渐近线。

		\item 双曲余弦函数在 \([0,+\infty[\) 上严格单调上升，而在 \(]-\infty,0]\) 上是严格单调下降的，并且
		\[
		\lim_{x\to0}\operatorname{ch}x=1,\qquad\lim_{x\to\pm\infty}\operatorname{ch}x=+\infty.
		\]
		它的图形关于 \(y\) 轴对称，无渐近线。

		\item 双曲正切函数在 \(\R\) 上严格单调上升，并且
		\[
		\lim_{x\to-\infty}\operatorname{th}x=-1,\qquad\lim_{x\to+\infty}\operatorname{th}x=1.
		\]
		它的图形关于原点对称，并且有无穷远分支 \(\Gamma_{+\infty}\) 与 \(\Gamma_{-\infty}\)，\(\Gamma_{+\infty}\) 以 \(y=1\) 为水平渐近线，\(\Gamma_{-\infty}\) 以 \(y=-1\) 为水平渐近线。

		\item 双曲余切函数在 \(\R-\{0\}\) 上严格单调下降，并且
		\[
		\lim_{x\to-\infty}\operatorname{cth}x=-1,\qquad\lim_{x\to0^-}\operatorname{cth}x=-\infty,
		\]
		\[
		\lim_{x\to0^+}\operatorname{cth}x=+\infty,\qquad\lim_{x\to+\infty}\operatorname{cth}x=1.
		\]
		它的图形关于原点对称，并且有四个无穷远分支 \(\Gamma_{-\infty}\)，\(\Gamma_{0^-}\)，\(\Gamma_{0^+}\)，\(\Gamma_{+\infty}\)。\(\Gamma_{-\infty}\) 以 \(y=-1\) 为水平渐近线，\(\Gamma_{0^-}\) 以负 \(y\) 轴为垂直渐近线，\(\Gamma_{0^+}\) 以正 \(y\) 轴为垂直渐近线，而 \(\Gamma_{+\infty}\) 以 \(y=1\) 为水平渐近线。
	\end{enumerate}

\end{mythm}

\begin{proof}

	1) 设 \(x_1,x_2\in\R-\{0\}\)，并且 \(x_1<x_2\)。

	由以 \(e\) 为底的指数函数的严格单调上升性，\(e^{2x_1}<e^{2x_2}\)，从而 \(1-e^{-2x_2}>1-e^{-2x_1}\)，于是
	\[
	\frac{\operatorname{sh}x_2}{\operatorname{sh}x_1}=\frac{e^{x_2}-e^{-x_2}}{e^{x_1}-e^{-x_1}}=e^{x_2-x_1}\left(\frac{1-e^{-2x_2}}{1-e^{-2x_1}}\right)>1.
	\]
	此即表明双曲正弦函数在 \(\R-\{0\}\) 上严格单调上升。

	现设 \(x_1,x_2\in\R\)，并且 \(x_1<0<x_2\)。由定义知
	\[
	\operatorname{sh}x_1<\operatorname{sh}0=0<\operatorname{sh}x_2.
	\]
	因此双曲正弦函数在 \(\R\) 上是严格单调上升的。直接计算得到
	\[
	\lim_{x\to-\infty}\operatorname{sh}x=-\infty,\qquad\lim_{x\to+\infty}\operatorname{sh}x=+\infty.
	\]
	由此可知双曲正弦函数的图形无渐近线，并且由 \(\operatorname{sh}(-x)=-\operatorname{sh}x,\ \forall\,x\in\R\) 知，此函数图形关于原点对称。

	2) 因为 \(\operatorname{ch}^2x-\operatorname{sh}^2x=1\ (\forall\,x\in\R)\)，并且 \(\operatorname{ch}x>0\)，所以 \(\operatorname{ch}x=\sqrt{1+\operatorname{sh}^2x}\ (\forall\,x\in\R)\)，由此，并根据双曲正弦函数的严格单调上升性和 \(\operatorname{sh}x<0\ (\forall\,x\in\R_*^-)\) 及 \(\operatorname{sh}x>0\ (\forall\,x\in\R_*^+)\) 推知，双曲余弦函数 \(\operatorname{ch}\) 在 \([0,+\infty[\) 上严格单调上升，而在 \(]-\infty,0]\) 上严格单调下降。

	现在直接由 \(\operatorname{ch}x\) 的表达式计算得到
	\[
	\lim_{x\to0}\operatorname{ch}x=1,\qquad\lim_{x\to\pm\infty}\operatorname{ch}x=+\infty.
	\]
	由此可知 \(\operatorname{ch}\) 的图形无渐近线，并且由 \(\operatorname{ch}(-x)=\operatorname{ch}x\ (\forall\,x\in\R)\) 推知，双曲余弦函数 \(\operatorname{ch}\) 的图形关于 \(y\) 轴对称。

	3) 由公式 \(\operatorname{th}^2x=1-\dfrac1{\operatorname{ch}^2x}\) 及双曲余弦的单调性推知，双曲正切 \(\operatorname{th}\) 在 \(\R\) 上是严格单调上升的。

	直接由 \(\operatorname{th}x\) 的表达式计算得到
	\[
	\lim_{x\to-\infty}\operatorname{th}x=-1,\qquad\lim_{x\to+\infty}\operatorname{th}x=1.
	\]
	由此可知双曲正切 \(\operatorname{th}\) 图形有无穷远分支 \(\Gamma_{-\infty}\) 与 \(\Gamma_{+\infty}\)，并且 \(\Gamma_{-\infty}\) 以 \(y=-1\) 为水平渐近线，\(\Gamma_{+\infty}\) 以 \(y=1\) 为水平渐近线。

	由于 \(\operatorname{th}(-x)=-\operatorname{th}x,\ \forall\,x\in\R\)，故此函数图形关于原点对称。

	4) 由公式 \(\operatorname{cth}^2x=1+\dfrac1{\operatorname{sh}^2x}\) 及双曲正弦的严格单调上升性推知，双曲余切函数在 \(\R-\{0\}\) 上是严格单调下降的。

	直接由 \(\operatorname{cth}x\) 的表达式计算得到
	\[
	\lim_{x\to-\infty}\operatorname{cth}x=-1,\qquad\lim_{x\to0^-}\operatorname{cth}x=-\infty,
	\]
	\[
	\lim_{x\to0^+}\operatorname{cth}x=+\infty,\qquad\lim_{x\to+\infty}\operatorname{cth}x=1.
	\]
	由此可知，双曲余切函数的图形有四个无穷远分支 \(\Gamma_{-\infty}\)，\(\Gamma_{0^-}\)，\(\Gamma_{0^+}\) 及 \(\Gamma_{+\infty}\)，并且 \(\Gamma_{-\infty}\) 以 \(y=-1\) 为水平渐近线，\(\Gamma_{0^-}\) 以负 \(y\) 轴为垂直渐近线，\(\Gamma_{0^+}\) 以正 \(y\) 轴为垂直渐近线，而 \(\Gamma_{+\infty}\) 以 \(y=1\) 为水平渐近线。

	最后由于 \(\operatorname{cth}(-x)=-\operatorname{cth}x\)，故此函数图形关于原点对称。

\end{proof}

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_258_Figure_5.jpeg}
	\caption{}
