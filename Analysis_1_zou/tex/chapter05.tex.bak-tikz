\chapter{一元实值函数的积分}

这一章我们介绍一元实值函数的Riemann 积分理论。利用积分函数我们严格定义了对数函数、指数函数及幂函数等基本初等函数.

\section{阶梯函数的积分}

\subsection{区间的分割}

\begin{mydef*}{}

	设 \([a,b]\subset\R\) 是任一有限闭区间，\([a,b]\) 的一个分割就是一组实数 \(\sigma=(a_0,a_1,\cdots,a_n)\) 使得
	\[
	a=a_0<a_1<\cdots<a_{n-1}<a_n=b,
	\]
	\(a_i\ (i=0,1,2,\cdots,n)\) 称为 \(\sigma\) 的分点。
	\[
	\delta(\sigma)=\max_{0\le i\le n-1}(a_{i+1}-a_i)
	\]
	称为分割 \(\sigma\) 的步长。

\end{mydef*}

\begin{sourceexample}{1}

	\(\forall\,n\in\N\)，
	\[
	\sigma_n=\left(a,a+\frac{b-a}{n},a+2\frac{b-a}{n},\cdots,a+(n-1)\frac{b-a}{n},b\right)
	\]
	是 \([a,b]\) 的一个等步长分割，且 \(\delta(\sigma_n)=\dfrac{b-a}{n}\)。

\end{sourceexample}

\begin{sourceexample}{2}

	设 \(\sigma\) 与 \(\sigma'\) 是 \([a,b]\) 的任意两个分割。合并 \(\sigma\) 与 \(\sigma'\) 的分点后所得到的 \([a,b]\) 的一个分割记为 \(\sigma\vee\sigma'\)。

\end{sourceexample}

显然 \(\sigma\vee\sigma'\) 可以通过在 \(\sigma\ (\sigma')\) 上逐步添加 \(\sigma'\ (\sigma)\) 的一个分点的方法来得到。

设
\[
\sigma=(a_0,a_1,\cdots,a_n),\quad \sigma'=(a_0',a_1',\cdots,a_m'),
\]
\[
\sigma\vee\sigma'=(b_0,b_1,\cdots,b_k),\quad \text{则}
\]
\[
\forall\,i=0,1,\cdots,k-1,\quad \exists\,j\in\{0,1,\cdots,n-1\},\quad s\in\{0,1,\cdots,m-1\}
\]
使得
\[
[b_i,b_{i+1}]\subset[a_j,a_{j+1}],\qquad [b_i,b_{i+1}]\subset[a_s',a_{s+1}'].
\]

\subsection{阶梯函数的积分}

\begin{mydef*}{}

	设 \(f:[a,b]\to\R\) 是一函数。如果存在 \([a,b]\) 的一个分割 \(\sigma=(a_0,a_1,\cdots,a_n)\) 及一个向量 \(\xi=[c_0,c_1,\cdots,c_{n-1}]\in\R^n\) 使得
	\[
	f(x)=c_i,\quad \forall\,x\in\ ]a_i,a_{i+1}[\ \ (i=0,1,\cdots,n-1),
	\]
	则我们称 \(f\) 是阶梯函数。

\end{mydef*}

\([\sigma,\xi]\triangleq[a_0,a_1,\cdots,a_n;\ c_0,c_1,\cdots,c_{n-1}]\) 称为适合于 \(f\) 的二元组。

\begin{sourceexample}{3}

	\(\forall\,a,b,c\in\R,\ 0<a<b\)，常值函数 \(x\longmapsto c,\ x\in[a,b]\) 是阶梯函数；符号函数 \(x\longmapsto\operatorname{sgn}(x),\ x\in[-a,b]\) 是阶梯函数；函数 \(x\longmapsto[x],\ x\in[1,3.5]\) 也是阶梯函数。

\end{sourceexample}

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_199_Figure_6.jpeg}
	\caption{}
	\label{fig:5-1}
\end{figure}

\textbf{附注}\quad 适合于阶梯函数 \(f\) 的二元组 \([\sigma,\xi]\) 不是唯一的。例如若 \([\sigma,\xi]=[a_0,a_1,\cdots,a_n;\ c_0,c_1,\cdots,c_{n-1}]\) 适合于阶梯函数 \(f\)，则在 \(]a_i,a_{i+1}[\) 上任意加入一个分点 \(\bar x\) 后，我们得到 \([a,b]\) 的另一个分割 \(\sigma'=(a_0,a_1,\cdots,a_i,\bar x,a_{i+1},\cdots,a_n)\) 及另一个向量 \(\xi'=[c_0,c_1,\cdots,c_i,c_i,c_{i+1},\cdots,c_{n-1}]\) 满足
\[
f(x)=c_k,\quad \forall\,x\in\ ]a_k,a_{k+1}[,\ k=0,1,\cdots,i-1,i+1,\cdots,n-1,
\]
\[
f(x)=c_i,\quad \forall\,x\in\ ]a_i,\bar x[\ \cup\ ]\bar x,a_{i+1}[.
\]
因此 \([\sigma',\xi']\) 也适合于 \(f\)。

另一方面，如果分割 \(\sigma=(a_0,a_1,\cdots,a_i,\cdots,a_n)\) 的分点 \(a_i\) 满足 \(c_{i-1}=c_i=f(a_i)\)，则删去 \(\sigma\) 的分点 \(a_i\) 后得到 \([a,b]\) 的另一分割 \(\sigma''=(a_0,a_1,\cdots,a_{i-1},a_{i+1},\cdots,a_n)\) 及另一向量 \(\xi''=[c_0,c_1,\cdots,c_{i-1},c_{i+1},\cdots,c_{n-1}]\) 满足
\[
f(x)=c_k,\quad \forall\,x\in\ ]a_k,a_{k+1}[,\ k=0,1,\cdots,i-2,i+1,\cdots,n-1,
\]
\[
f(x)=c_i,\quad \forall\,x\in\ ]a_{i-1},a_{i+1}[.
\]
因此 \([\sigma'',\xi'']\) 也适合于 \(f\)。

\begin{mylemma*}{}

	设 \(f:[a,b]\to\R\) 是任一阶梯函数，\([\sigma,\xi]\) 适合于 \(f\)，\(\sigma'\) 是 \([a,b]\) 的任一分割，则存在向量 \(\eta\) 使得 \([\sigma\vee\sigma',\eta]\) 适合于 \(f\)。

\end{mylemma*}

\begin{proof}

	设 \([\sigma,\xi]=[a_0,a_1,\cdots,a_n;\ c_0,c_1,\cdots,c_{n-1}]\)。由于 \(\sigma\vee\sigma'\) 也是 \([a,b]\) 的一个分割，故若令
	\[
	\sigma\vee\sigma'=(b_0,b_1,\cdots,b_m),
	\]
	则 \(\forall\,i=0,1,\cdots,m-1\)，存在 \(j(i)\in\{0,1,\cdots,n-1\}\) 使得 \(]b_i,b_{i+1}[\subset\ ]a_{j(i)},a_{j(i)+1}[\)，于是
	\[
	f(x)=c_{j(i)},\quad \forall\,x\in\ ]b_i,b_{i+1}[,\quad \forall\,i=0,1,\cdots,m-1.
	\]
	令 \(d_i=c_{j(i)}\ (i=0,1,\cdots,m-1)\) 及 \(\eta=[d_0,d_1,\cdots,d_{m-1}]\)，则 \([\sigma\vee\sigma',\eta]\) 适合于 \(f\)。

\end{proof}

\begin{myprop*}{}

	设 \(f:[a,b]\to\R\) 是任一阶梯函数，\([\sigma,\xi]=[a_0,a_1,\cdots,a_n;\ c_0,c_1,\cdots,c_{n-1}]\) 与 \([\sigma',\xi']=[a_0',a_1',\cdots,a_m';\ c_0',c_1',\cdots,c_{m-1}']\) 都适合于 \(f\)，则
	\[
	\sum_{i=0}^{n-1}c_i(a_{i+1}-a_i)=\sum_{j=0}^{m-1}c_j'(a_{j+1}'-a_j').
	\]

\end{myprop*}

\begin{proof}

	我们记
	\[
	I[\sigma,\xi]=\sum_{i=0}^{n-1}c_i(a_{i+1}-a_i),
	\]
	\[
	I[\sigma',\xi']=\sum_{j=0}^{m-1}c_j'(a_{j+1}'-a_j').
	\]
	根据引理，存在一个向量 \(\eta\) 使得 \([\sigma\vee\sigma',\eta]\) 适合于 \(f\)。只需要证明 \(I[\sigma,\xi]=I[\sigma\vee\sigma',\eta]=I[\sigma',\xi']\)。

	我们首先假设 \(\sigma\vee\sigma'\) 比 \(\sigma\) 多一个分点 \(\bar x\)。令 \(\bar x\in\ ]a_i,a_{i+1}[\)。那末
	\[
	\sigma\vee\sigma'=(a_0,a_1,\cdots,a_i,\bar x,a_{i+1},\cdots,a_n),
	\]
	\[
	\eta=[c_0,c_1,\cdots,c_i,c_i,c_{i+1},\cdots,c_{n-1}],
	\]
	于是
	\[
	\begin{aligned}
	I[\sigma\vee\sigma',\eta]&=c_0(a_1-a_0)+c_1(a_2-a_1)+\cdots+c_i(\bar x-a_i)\\
	&\qquad+c_i(a_{i+1}-\bar x)+\cdots+c_{n-1}(a_n-a_{n-1})\\
	&=c_0(a_1-a_0)+c_1(a_2-a_1)+\cdots+c_i(a_{i+1}-a_i)\\
	&\qquad+\cdots+c_{n-1}(a_n-a_{n-1})\\
	&=I[\sigma,\xi].
	\end{aligned}
	\]
	对一般的 \(\sigma\) 与 \(\sigma'\)，由于 \(\sigma\vee\sigma'\) 可以通过在 \(\sigma\) 上逐步添加 \(\sigma'\) 的分点的方法来得到，故由归纳法我们有 \(I[\sigma\vee\sigma',\eta]=I[\sigma,\xi]\)。

	同理，存在向量 \(\eta'\) 使得 \([\sigma'\vee\sigma,\eta']\) 也适合于 \(f\)，并且 \(I[\sigma'\vee\sigma,\eta']=I[\sigma',\xi']\)。

	由于 \(\sigma\vee\sigma'=\sigma'\vee\sigma\)，故 \(\eta=\eta'\)。因此 \(I[\sigma\vee\sigma',\eta]=I[\sigma'\vee\sigma,\eta']\)，从而 \(I[\sigma,\xi]=I[\sigma\vee\sigma',\eta]=I[\sigma',\xi']\)。

\end{proof}

上述命题表明，\(I[\sigma,\xi]\) 是一个只与 \(f\) 有关而与适合于 \(f\) 的二元组 \([\sigma,\xi]\) 的选择无关的定数。因此我们可以引入下述定义。

\begin{mydef*}{}

	设 \(f:[a,b]\to\R\) 是任一阶梯函数，\([\sigma,\xi]=[a_0,a_1,\cdots,a_n;\ c_0,c_1,\cdots,c_{n-1}]\) 适合于 \(f\)。则实数
	\[
	I(f)=c_0(a_1-a_0)+c_1(a_2-a_1)+\cdots+c_{n-1}(a_n-a_{n-1})
	\]
	称为 \(f\) 在 \([a,b]\) 上的积分，记为 \(\displaystyle\int_a^b f(x)dx\)。于是
	\[
	\int_a^b f(x)dx=\sum_{i=0}^{n-1}c_i(a_{i+1}-a_i).
	\]

\end{mydef*}

\begin{sourceexample}{4}

	\(\forall\,c\in\R\)，常值函数 \(x\longmapsto c,\ x\in[a,b]\ (a<b)\) 的积分
	\[
	\int_a^b c\,dx=c\,(b-a).
	\]

\end{sourceexample}

\begin{sourceexample}{5}

	符号函数 \(x\longmapsto\operatorname{sgn}(x),\ x\in[a,b]\ (a<b)\) 的积分
	\[
	\int_a^b\operatorname{sgn}(x)dx=
	\begin{cases}
	b-a, & \text{若}\ 0\le a<b, \\
	a+b, & \text{若}\ a<0<b, \\
	a-b, & \text{若}\ a<b\le0.
	\end{cases}
	\]

\end{sourceexample}

从阶梯函数积分的定义可知，积分值 \(\displaystyle\int_a^b f(x)dx\) 与 \(f\) 在分点 \(a_i\) 的值 \(f(a_i)\ (i=0,1,\cdots,n)\) 无关。因此改变阶梯函数 \(f\) 在分点 \(a_i\) 的值所得新的阶梯函数 \(g\) 与 \(f\) 在 \([a,b]\) 上有相同的积分值。

从几何上看，阶梯函数 \(f\) 的积分 \(\displaystyle\int_a^b f(x)dx\) 表示在平面直角坐标系 \(\{O;x,y\}\) 的 \(x\) 轴上以 \([a_i,a_{i+1}]\) 为底边，以 \(c_i\) 为“高”的长方形“面积”的代数和。

