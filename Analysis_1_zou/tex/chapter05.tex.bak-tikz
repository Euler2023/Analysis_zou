图 5-15 是各双曲函数的大致图形。

\subsubsection*{7) 反双曲函数}

由\rthm{thm:hyperbolic-monotonicity} 知，双曲正弦、余弦、正切、余切分别是从 \(\R\) 到 \(\R\)、从 \([0,+\infty[\) 到 \([1,+\infty[\)、从 \(\R\) 到 \(]-1,1[\)、从 \(\R-\{0\}\) 到 \(\R-[-1,1]\) 上的严格单调的连续函数，根据\rthm{thm:inverse-function-continuity}，它们都有反函数存在。

\begin{mydef*}{}

	\begin{enumerate}[label=\arabic*)]
		\item 函数 \(\operatorname{sh}:\R\to\R\) 的反函数称为反双曲正弦函数，记为
		\[
		\operatorname{Arg}\operatorname{sh}:\R\to\R.
		\]

		\item 函数 \(\operatorname{ch}:[0,+\infty[\to[1,+\infty[\) 的反函数称为反双曲余弦函数，记为
		\[
		\operatorname{Arg}\operatorname{ch}:[1,+\infty[\to[0,+\infty[.
		\]

		\item 函数 \(\operatorname{th}:\R\to\ ]-1,1[\) 的反函数称为反双曲正切函数，记为
		\[
		\operatorname{Arg}\operatorname{th}:\ ]-1,1[\to\R.
		\]

		\item 函数 \(\operatorname{cth}:\R-\{0\}\to\R-[-1,1]\) 的反函数称为反双曲余切函数，记为
		\[
		\operatorname{Arg}\operatorname{cth}:\R-[-1,1]\to\R-\{0\}.
		\]
	\end{enumerate}

\end{mydef*}

\begin{mythm}{}{inverse-hyperbolic-functions}

	\begin{enumerate}[label=\arabic*)]
		\item 反双曲函数 \(\operatorname{Arg}\operatorname{sh}\)、\(\operatorname{Arg}\operatorname{ch}\)、\(\operatorname{Arg}\operatorname{th}\)、\(\operatorname{Arg}\operatorname{cth}\) 除 \(\operatorname{Arg}\operatorname{cth}\) 是严格单调下降外其余都是严格单调上升的连续函数。

		\item 反双曲函数的显示表达式：
		\[
		\operatorname{Arg}\operatorname{sh}x=\log\left(x+\sqrt{x^2+1}\right),\quad x\in\R;
		\]
		\[
		\operatorname{Arg}\operatorname{ch}x=\log\left(x+\sqrt{x^2-1}\right),\quad x\in[1,+\infty[;
		\]
		\[
		\operatorname{Arg}\operatorname{th}x=\frac12\log\frac{1+x}{1-x},\quad x\in\ ]-1,1[;
		\]
		\[
		\operatorname{Arg}\operatorname{cth}x=\frac12\log\frac{x+1}{x-1},\quad x\in\R-[-1,1].
		\]
	\end{enumerate}

\end{mythm}

\begin{proof}

	性质 1) 显然，下面我们来证明反双曲函数的显示表达式。

	对 \(\operatorname{Arg}\operatorname{sh}x\)：由 \(y=\operatorname{Arg}\operatorname{sh}x\) 得到 \(x=\operatorname{sh}y\)。因为
	\[
	\operatorname{ch}y=\sqrt{\operatorname{sh}^2y+1}=\sqrt{x^2+1},
	\]
	所以
	\[
	e^y=\operatorname{sh}y+\operatorname{ch}y=x+\sqrt{x^2+1},
	\]
	从而
	\[
	\operatorname{Arg}\operatorname{sh}x=y=\log\left(x+\sqrt{x^2+1}\right).
	\]
	对 \(\operatorname{Arg}\operatorname{ch}x\)：由 \(y=\operatorname{Arg}\operatorname{ch}x\) 得到 \(x=\operatorname{ch}y\)。于是
	\[
	\operatorname{sh}y=\sqrt{\operatorname{ch}^2y-1}=\sqrt{x^2-1},
	\]
	从而
	\[
	e^y=\operatorname{ch}y+\operatorname{sh}y=x+\sqrt{x^2-1},
	\]
	因此
	\[
	\operatorname{Arg}\operatorname{ch}x=y=\log\left(x+\sqrt{x^2-1}\right).
	\]
	对 \(\operatorname{Arg}\operatorname{th}x\)：由 \(y=\operatorname{Arg}\operatorname{th}x\) 得到 \(x=\operatorname{th}y\)。因为
	\[
	\operatorname{th}y=\frac{e^y-e^{-y}}{e^y+e^{-y}}=\frac{e^{2y}-1}{e^{2y}+1},
	\]
	所以
	\[
	e^{2y}=\frac{1+x}{1-x},
	\]
	从而
	\[
	\operatorname{Arg}\operatorname{th}x=y=\frac12\log\frac{1+x}{1-x}.
	\]
	对 \(\operatorname{Arg}\operatorname{cth}x\)：由 \(y=\operatorname{Arg}\operatorname{cth}x\) 得到 \(x=\operatorname{cth}y\)。因为
	\[
	\operatorname{cth}y=\frac{e^y+e^{-y}}{e^y-e^{-y}}=\frac{e^{2y}+1}{e^{2y}-1},
	\]
	所以
	\[
	e^{2y}=\frac{x+1}{x-1},
	\]
	因此
	\[
	\operatorname{Arg}\operatorname{cth}x=y=\frac12\log\frac{x+1}{x-1}.
	\]

\end{proof}

\textbf{附注}\quad 反双曲函数 \(\operatorname{Arg}\operatorname{sh}\)、\(\operatorname{Arg}\operatorname{ch}\)、\(\operatorname{Arg}\operatorname{th}\)、\(\operatorname{Arg}\operatorname{cth}\) 的图形可由相应双曲函数 \(\operatorname{sh}\)、\(\operatorname{ch}\)、\(\operatorname{th}\)、\(\operatorname{cth}\) 的图形关于直线 \(y=x\) 对称而得到。图 5-16 是它们的图形。

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_261_Figure_1.jpeg}
	\caption{}
	\label{fig:5-16}
\end{figure}

的对称图形得到，有一点要注意。在作双曲余弦函数 \(\operatorname{ch}\) 的图形关于 \(y=x\) 的对称图形时，只有位于 \(y\ge0\) 上半平面的那一分支才是反双曲余弦 \(\operatorname{Arg}\operatorname{ch}\) 的图形。

上面我们定义的七类函数连同有理整函数（多项式函数）、有理分式函数、三角函数、反三角函数一起统称为基本初等函数。

由基本初等函数经过有限次加、减、乘、除四则运算及函数的复合所得到的函数称为有限形式的初等函数。

作为初等函数的一个例子，我们介绍所谓的幂指数函数。

\textbf{幂指数函数}\quad 设 \(u,v:X\to\R\) 是任意两个函数，使得 \(\forall\,x\in X\)，\(u(x)^{v(x)}\) 有定义，则函数
\[
x\longmapsto u(x)^{v(x)},\quad x\in X
\]
称为幂指数函数。我们设 \(a\in X\) 是一聚点。

1) 若 \(\lim_{x\to a}u(x)=A>0\)，\(\lim_{x\to a}v(x)=B\)，则
\[
\lim_{x\to a}u(x)^{v(x)}=\lim_{x\to a}e^{v(x)\log u(x)}=e^{\lim_{x\to a}v(x)\log u(x)}=e^{B\log A}=A^B.
\]

2) 若 \(\lim_{x\to a}u(x)=0\)，但 \(\lim_{x\to a}v(x)\log u(x)=c\)，则
\[
\lim_{x\to a}u(x)^{v(x)}=\lim_{x\to a}e^{v(x)\log u(x)}=e^{\lim_{x\to a}v(x)\log u(x)}=\begin{cases} e^c, & \text{若}\ c\in\R, \\ +\infty, & \text{若}\ c=+\infty, \\ 0, & \text{若}\ c=-\infty. \end{cases}
\]

3) 若 \(\lim_{x\to a}u(x)=A\)，\(\lim_{x\to a}v(x)=B\) 出现下列三种情形：
\[
A=1,\ B=\pm\infty;\qquad A=0,\ B=0;\qquad A=\pm\infty,\ B=0.
\]
则 \(u(x)^{v(x)}\) 分别为 \(1^\infty\)，\(0^0\)，\(\pm\infty^0\) 不定型，这种不定型极限的一般研究我们将在以后进行。

下面介绍一个典型的 \(1^\infty\) 不定型极限。

\begin{sourceexample}{1}

	证明

	1) \(\displaystyle\lim_{x\to0}(1+x)^{\frac1x}=e\)。

	2) \(\displaystyle\lim_{x\to\pm\infty}\left(1+\frac1x\right)^x=e\)，
	\[
	\lim_{n\to\pm\infty}\left(1+\frac1n\right)^n=e,\quad(n\in\Z).
	\]

	3) \(\displaystyle\lim_{h\to0}(1+hx)^{\frac1h}=e^x,\ \forall\,x\in\R\)。

	首先，我们考虑 \(\displaystyle\lim_{x\to0}(1+x)^{\frac1x}\)。这是 \(1^\infty\) 不定型极限。当 \(|x|\) 充分小时，\(1+x>0\)，因此
	\[
	(1+x)^{\frac1x}=e^{\frac1x\log(1+x)}.
	\]
	由于 \(\log(1+x)=\displaystyle\int_1^{1+x}\frac1t\,dt\)，故由第一积分中值公式知，
	\[
	\log(1+x)=\frac1\xi\int_1^{1+x}dt=\frac x\xi.
	\]
	这里 \(\xi\) 介于 \(1\) 与 \(1+x\) 之间，从而 \(\xi\to1\ (x\to0)\)。因此
	\[
	\lim_{x\to0}(1+x)^{\frac1x}=\lim_{x\to0}e^{\frac1x\log(1+x)}=e^{\lim_{x\to0}\frac1x\log(1+x)}=e^{\lim_{x\to0}\frac1\xi}=e.
	\]
	现在我们令 \(y=\dfrac1x\)，则 \(y\to0\ (x\to\pm\infty)\)。从而
	\[
	\lim_{x\to\pm\infty}\left(1+\frac1x\right)^x=\lim_{y\to0}(1+y)^{\frac1y}=e.
	\]
	特别地取 \(x=n\in\Z\)，则
	\[
	\lim_{n\to\pm\infty}\left(1+\frac1n\right)^n=e.
	\]
	最后令 \(y=hx\)，当 \(x\neq0\) 时 \(y\neq0\)，并且 \(y\to0\ (h\to0)\)。因此
	\[
	\lim_{h\to0}(1+hx)^{\frac1h}=\lim_{y\to0}\left[(1+y)^{\frac1y}\right]^x=\left[\lim_{y\to0}(1+y)^{\frac1y}\right]^x=e^x.
	\]
	当 \(x=0\) 时，\(\displaystyle\lim_{h\to0}(1+hx)^{\frac1h}=1=e^0\)。

\end{sourceexample}

\begin{sourceexample}{2}

	证明：\(\forall\,\alpha\in\R\)，\(\displaystyle\lim_{x\to0}\frac{(1+x)^\alpha-1}{x}=\alpha\)。

	为此令 \((1+x)^\alpha-1=y\)，则 \(y\to0\ (x\to0)\)，并且 \((1+x)^\alpha=1+y\)。于是 \(\alpha\log(1+x)=\log(1+y)\)，从而
	\[
	\begin{aligned}
	\lim_{x\to0}\frac{(1+x)^\alpha-1}{x}
	&=\lim_{x\to0}\frac yx\\
	&=\lim_{x\to0}\frac{y}{\log(1+y)}\cdot\frac{\alpha\log(1+x)}x\\
	&=\lim_{y\to0}\frac1{\log(1+y)^{\frac1y}}\cdot\lim_{x\to0}\alpha\log(1+x)^{\frac1x}\\
	&=\alpha\cdot\frac1{\log e}\cdot\log e\\
	&=\alpha.
	\end{aligned}
	\]

\end{sourceexample}

\begin{sourceexample}{3}

	计算 \(\displaystyle\lim_{x\to0}\left(\frac{1+\operatorname{tg}x}{1+\sin x}\right)^{\frac1{\sin x}}\)。

	这是 \(1^\infty\) 不定型极限，我们把它化为 \(\displaystyle\lim_{x\to0}(1+x)^{\frac1x}\) 型极限进行计算。
	\[
	\begin{aligned}
	&\lim_{x\to0}\left(\frac{1+\operatorname{tg}x}{1+\sin x}\right)^{\frac1{\sin x}}\\
	=&\lim_{x\to0}\left(1+\frac{\operatorname{tg}x-\sin x}{1+\sin x}\right)^{\frac1{\sin x}}\\
	=&\left[\lim_{y\to0}(1+y)^{\frac1y}\right]^{\lim_{x\to0}\frac{1-\cos x}{\cos x(1+\sin x)}}\\
	=&\,e^0\\
	=&\,1.
	\end{aligned}
	\]

\end{sourceexample}

最后作为这一节的结束，我们来考虑下面的一个重要极限。

\begin{sourceexample}{4}

	证明：\(\forall\,\alpha>0\)，\(\displaystyle\lim_{x\to+\infty}\frac{e^x}{x^\alpha}=+\infty\)。

	我们只需证明 \(x=n\in\N\) 时极限成立即可。

	事实上，如果 \(\displaystyle\lim_{n\to+\infty}\frac{e^n}{n^\alpha}=+\infty\)，那末由函数 \(x\longmapsto e^x\)，\(x\in\ ]0,+\infty[\) 及 \(x\longmapsto x^\alpha\)，\(x\in\ ]0,+\infty[\) 的严格单调上升性我们有：\(\forall\,x>0\)
	\[
	\frac{e^x}{x^\alpha}\ge\frac{e^{[x]}}{([x]+1)^\alpha}=\frac1e\cdot\frac{e^{[x]+1}}{([x]+1)^\alpha}.
	\]
	由于 \(\displaystyle\lim_{x\to+\infty}([x]+1)=+\infty\)，故 \(\displaystyle\lim_{x\to+\infty}\frac{e^{[x]+1}}{([x]+1)^\alpha}=+\infty\)，从而
	\[
	\lim_{x\to+\infty}\frac{e^x}{x^\alpha}=+\infty.
	\]
	下面我们就来证明 \(\displaystyle\lim_{n\to+\infty}\frac{e^n}{n^\alpha}=+\infty\)。

	固定 \(k\in\N\) 使 \(k>\alpha\)。令 \(h=e-1\)，\(\forall\,n>k\)，有
	\[
	\frac{e^n}{n^\alpha}=\frac{(1+h)^n}{n^\alpha}>\frac{C_n^{k+1}h^{k+1}}{n^k}
	\]
	\[
	=\frac{n(n-1)(n-2)\cdots(n-k)}{(k+1)!\,n^k}h^{k+1}
	\]
	\[
	=n\left(1-\frac1n\right)\left(1-\frac2n\right)\cdots\left(1-\frac kn\right)\frac{h^{k+1}}{(k+1)!}.
	\]
	由于 \(\dfrac{h^{k+1}}{(k+1)!}>0\) 为常数，
	\[
	\lim_{n\to+\infty}\left(1-\frac1n\right)\left(1-\frac2n\right)\cdots\left(1-\frac kn\right)=1,
	\]
	故
	\[
	\lim_{n\to+\infty}n\left(1-\frac1n\right)\left(1-\frac2n\right)\cdots\left(1-\frac kn\right)\frac{h^{k+1}}{(k+1)!}=+\infty
	\]
	，从而 \(\displaystyle\lim_{n\to+\infty}\frac{e^n}{n^\alpha}=+\infty\)。

\end{sourceexample}

\subsection*{习 题}

\begin{exercise}
	\item 证明\rthm{thm:general-logarithm-properties}、\rthm{thm:general-exponential-properties}、\rthm{thm:power-function-properties}、\rthm{thm:hyperbolic-identities}。
\end{exercise}

\begin{exercise}
	\item 设 \(f:[a,b]\to\R^+\) 是任一连续函数。证明：
	\begin{enumerate}[label=\arabic*)]
		\item \(\displaystyle\left[\int_a^b f^n(x)dx\right]^{\frac1n}\le(b-a)^{\frac1n}\sup_{a\le x\le b}f(x),\quad\forall\,n\in\N\)。
		\item 利用 \(f\) 的连续性及确界特性证明：
		\[
		(\forall\,\varepsilon>0)(\exists\,\delta>0)\Longrightarrow\left[\int_a^b f^n(x)dx\right]^{\frac1n}\ge\delta^{\frac1n}\left(\sup_{a\le x\le b}f(x)-\varepsilon\right).
		\]
		\item 由此推出 \(\displaystyle\lim_{n\to+\infty}\left[\int_a^b f^n(x)dx\right]^{\frac1n}=\sup_{a\le x\le b}f(x)\)。
		\item 若 \(g:[a,b]\to\R^+\) 是任一 Riemann 可积函数，则
		\[
		\lim_{n\to+\infty}\left[\int_a^b f^n(x)g(x)dx\right]^{\frac1n}=\sup_{a\le x\le b}f(x).
		\]
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设
	\[
	x_n=\sqrt[n]{\left[1+\left(\frac1n\right)^2\right]\left[1+\left(\frac2n\right)^2\right]\cdots\left[1+\left(\frac nn\right)^2\right]},
	\]
	\[
	y_n=\left(\sqrt[n]{n}\cdot\sqrt[n]{2n}\cdot\ \cdots\ \cdot\sqrt[n]{n^2}\right)^{-\frac1{\log n}},
	\]
	试研究序列 \(\langle x_n\rangle\) 与 \(\langle y_n\rangle\) 的收敛性，并求其极限。
\end{exercise}

\begin{exercise}
	\item 计算下列各极限：
	\begin{enumerate}[label=\arabic*)]
		\item \(\displaystyle\lim_{x\to0}\frac{\log_a(1+x)}x\ (0<a\neq1)\)；
		\item \(\displaystyle\lim_{x\to0}\frac{a^x-1}x\ (a>0)\)；
		\item \(\displaystyle\lim_{x\to0}\frac{\sqrt[n]{1+ax}-\sqrt[m]{1+bx}}x\)；
		\item \(\displaystyle\lim_{x\to1}x^{\frac1{1-x}}\)；
		\item \(\displaystyle\lim_{x\to\frac\pi4}(\operatorname{tg}x)^{\operatorname{tg}2x}\)；
		\item \(\displaystyle\lim_{x\to1}(1+\sin\pi x)^{\operatorname{ctg}\pi x}\)；
		\item \(\displaystyle\lim_{x\to0}\left(\frac{a_1^x+a_2^x+\cdots+a_n^x}{n}\right)^{\frac1x}\ (a_i>0)\)；
		\item \(\displaystyle\lim_{h\to0}\frac{\log(x+h)+\log(x-h)-2\log x}{h^2}\)；
		\item \(\displaystyle\lim_{x\to\pm\infty}\left(\sin\frac1x+\cos\frac1x\right)^x\)；
		\item \(\displaystyle\lim_{x\to0}\frac{\operatorname{sh}x}{x}\)；
		\item \(\displaystyle\lim_{x\to0}\frac{\operatorname{ch}2x-1}{x^2}\)；
		\item \(\displaystyle\lim_{x\to0}\frac{e^{\sin2x}-e^{\sin x}}{\operatorname{th}x}\)；
		\item \(\displaystyle\lim_{x\to0}\frac{\operatorname{sh}^2x}{\log(\operatorname{ch}2x)}\)；
		\item \(\displaystyle\lim_{x\to\pm\infty}\left(\frac{\operatorname{ch}\dfrac\pi x}{\cos\dfrac\pi x}\right)^{x^2}\)。
	\end{enumerate}
\end{exercise}

