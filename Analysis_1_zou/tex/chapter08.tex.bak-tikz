图 8-4
\end{center}

\subsection*{习 题}

\begin{exercise}
	\item 计算下列各极限值：
	\begin{enumerate}[label=\arabic*)]
		\item $\displaystyle\lim_{x\to0}\frac{1-\cos x}{\operatorname{tg}^2x}$；
		\item $\displaystyle\lim_{x\to0}\frac{(1-\cos x)\operatorname{arctg}x}{x\sin^2x}$；
		\item $\displaystyle\lim_{x\to0}\frac{(1-e^x)\sin x}{x^2+x^3}$；
		\item $\displaystyle\lim_{x\to0}\left(\frac{\operatorname{tg}x}{x}\right)^{1/x^2}$；
		\item $\displaystyle\lim_{x\to\pi/2}e^{1/(\pi-2x)}\log\frac{2x}{\pi}$；
		\item $\displaystyle\lim_{x\to0^+}(\cos x)^{1/x^a}\ (a\geqslant0)$；
		\item $\displaystyle\lim_{x\to+\infty}\frac1x\log\frac{e^x-1}{x}$；
		\item $\displaystyle\lim_{x\to+\infty}x(\log x)^2\left[\sin\frac1{\log x}-\sin\frac1{\log(x+1)}\right]$；
		\item $\displaystyle\lim_{x\to+\infty}\frac{x^{x^{1/x}}-x}{(\log x)^2}$；
		\item $\displaystyle\lim_{x\to0}\frac{\operatorname{tg}^3x}{x^7}\left[(\cos x)^{x^2}-1\right]$；
		\item $\displaystyle\lim_{x\to e}(\log x-1)\log|x-e|$；
		\item $\displaystyle\lim_{x\to0}\frac{(1+\sin x)^{1/x}-e^{1-x/2}}{(1+\operatorname{tg}x)^{1/x}-e^{1-x/2}}$；
		\item 确定常数 $a$，使得
		\[\lim_{x\to0}x^a\left[\frac{(\operatorname{sh}\sqrt[3]{x})^3-x}{\sqrt[3]{\operatorname{sh}x^3}-x}\right]=A\neq0.\]
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 求下列各函数 $f$ 的局部极值点与相应的局部极值：
	\begin{enumerate}[label=\arabic*)]
		\item $f(x)=\sqrt{2x-x^2}$；
		\item $f(x)=x+\dfrac1x$；
		\item $f(x)=x^x$；
		\item $f(x)=e^{(x-1)/x^2}$；
		\item $f(x)=\sqrt[3]{x^3-3x+2}$；
		\item $f(x)=(1+\operatorname{tg}x)^{-\operatorname{tg}x}$。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 试求函数
	\[x\longmapsto f(x)=\begin{cases} x^{2x}, & x>0;\\[1ex] x+1, & x\leqslant0 \end{cases}\]
	的局部极值点与局部极值。
\end{exercise}

\begin{exercise}
	\item 设 $n,m\in\N$，$a>0$。试确定函数
	\[x\longmapsto f(x)=x^n\cdot(a-x)^m,\quad x\in\R\]
	的局部极值点与局部极值，并画出图形。
\end{exercise}

\begin{exercise}
	\item 试找出 Riemann 函数
	\[x\longmapsto R(x)=\begin{cases} 0, & x\in\ ]0,1[\ \cap\Q^c;\\[1ex] \dfrac{1}{p}, & x\in\ ]0,1]\cap\Q,\quad x=\dfrac{q}{p},\ p,q\text{ 互质};\\[1ex] 1, & x=0 \end{cases}\]
	的全部严格局部极大值点。
\end{exercise}

\begin{exercise}
	\item 设 $a_i\in\R$ $(i=1,2,\ldots,n)$。
	\begin{enumerate}[label=\arabic*)]
		\item 求函数 $x\longmapsto f(x)=\displaystyle\sum_{i=1}^{n}(x-a_i)^2$，$x\in\R$ 的局部极小值；
		\item 求函数 $x\longmapsto f(x)=\displaystyle\sum_{i=1}^{n}|x-a_i|^2$，$x\in\R$ 的局部极小值；
		\item 求函数 $x\longmapsto f(x)=\displaystyle\sum_{i=1}^{n}\lambda_i|x-a_i|$，$x\in\R$ 的局部极小值，这里 $\lambda_i>0$ $(i=1,2,\dots,n)$。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设函数 $f:[a,b]\to\R$ 在 $[a,b]$ 上连续，并且 $[a,b]$ 的每一点 $x$ 都是 $f$ 的局部极大值点，证明 $f$ 是常值函数。
\end{exercise}

\begin{exercise}
	\item 试利用反证法及区间套定理证明，不可能存在一个函数 $f:I\to\R$（$I\subset\R$ 是一区间），使得 $I$ 的每一点都是 $f$ 的严格局部极大值点。
\end{exercise}

\begin{exercise}
	\item 求函数 $x\longmapsto f(x)=x^5-3x$，$x\in\R$ 在集合 $E=\{x\in\R\mid x^4+36\leqslant13x^2\}$ 上的最大值。
\end{exercise}

\begin{exercise}
	\item 画出下列各函数 $f$ 的图形。
	\begin{enumerate}[label=\arabic*)]
		\item $f(x)=x^2\operatorname{arctg}\dfrac{1}{1+x}$；
		\item $f(x)=e^{\frac{1}{x}}\sqrt{x(x+2)}$；
		\item $f(x)=x+\sqrt{x^2+1}$；
		\item $f(x)=\dfrac{\log|x-2|}{\log|x|}$。
	\end{enumerate}
\end{exercise}
