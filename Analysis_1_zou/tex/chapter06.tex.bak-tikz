	\centering
	\includegraphics[
	width=.72\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_270_Figure_1.jpeg}
	\caption{}
	\label{fig:6-1}
\end{figure}

如果 \(f\) 在 \(a\) 处右（左）可导，则我们称函数 \(f\) 的曲线 \(\Gamma\) 在 \(M_0(a,f(a))\) 处有右（左）切线 \(T\ (T')\)。

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.72\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_270_Figure_4.jpeg}
	\caption{}
	\label{fig:6-2}
\end{figure}

若 \(f\) 在 \(a\) 处可导，并且 \(f'(a)=0\)，则曲线 \(\Gamma\) 在 \(M_0\) 处的切线 \(T\) 平行于 \(x\) 轴。

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.72\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_271_Figure_0.jpeg}
	\caption{}
	\label{fig:6-3}
\end{figure}

关于函数的导数与单侧导数之间的联系，我们有下述定理。

\begin{mythm}{}{derivative-one-sided-derivatives}

	设 \(f:X\to\R\) 是任一函数，\(a\in X\) 是 \(X\) 的一个双侧聚点。\(f\) 在 \(a\) 处可导的充分必要条件是：\(f\) 在 \(a\) 处左、右可导，并且 \(f'(a^-)=f'(a^+)\)。这时
	\[
	f'(a^-)=f'(a^+)=f'(a).
	\]

\end{mythm}

\begin{proof}

	直接由\rthm{thm:limit-equals-one-sided-limits} 推出。

\end{proof}

\subsection{可导性的另一表示法}

\begin{mythm}{}{caratheodory-derivative}

	设 \(f:X\to\R\) 是任一函数，\(a\in X\) 是 \(X\) 的一聚点。\(f\) 在 \(a\) 处可导的充分必要条件是：存在一个函数 \(\varphi:X\to\R\) 使得

	\begin{enumerate}[label=\arabic*)]
		\item \(f(x)-f(a)=\varphi(x)(x-a),\ \forall\,x\in X\)；

		\item \(\varphi\) 在 \(a\) 处连续，
	\end{enumerate}

	这时 \(f'(a)=\varphi(a)\)。

\end{mythm}

\begin{proof}

	必要性 设 \(f\) 在 \(a\) 处可导，于是由定义，我们有
	\[
	f'(a)=\lim_{x\to a}\frac{f(x)-f(a)}{x-a}.
	\]
	令
	\[
	\varepsilon(x)=\frac{f(x)-f(a)}{x-a}-f'(a),\quad\forall\,x\in X-\{a\},
	\]
	则 \(\lim_{x\to a}\varepsilon(x)=0\)。我们定义函数 \(\varphi:X\to\R\) 如下：
	\[
	\varphi(x)=f'(a)+\varepsilon(x),\quad\forall\,x\in X-\{a\},\qquad\varphi(a)=f'(a).
	\]
	则 \(\varphi\) 在 \(a\) 处连续，并且
	\[
	f(x)-f(a)=\varphi(x)(x-a),\quad\forall\,x\in X,
	\]
	\[
	f'(a)=\varphi(a).
	\]
	充分性 设存在满足定理条件 1) 与 2) 的函数 \(\varphi:X\to\R\)，那末
	\[
	\frac{f(x)-f(a)}{x-a}=\varphi(x),\quad\forall\,x\in X-\{a\}.
	\]
	由 \(\varphi\) 在 \(a\) 处的连续性推得
	\[
	\lim_{x\to a}\frac{f(x)-f(a)}{x-a}=\lim_{x\to a}\varphi(x)=\varphi(a).
	\]
	此即表明 \(f\) 在 \(a\) 处可导，并且 \(f'(a)=\varphi(a)\)。

\end{proof}

\begin{mycor*}{}

	若函数 \(f:X\to\R\) 在 \(a\) 处可导，则 \(f\) 在 \(a\) 处连续。

\end{mycor*}

\begin{proof}

	因为 \(f\) 在 \(a\) 处可导，故存在函数 \(\varphi:X\to\R\) 使得
	\[
	f(x)-f(a)=\varphi(x)(x-a),\quad\forall\,x\in X,\quad\varphi\ \text{在}\ a\ \text{处连续}.
	\]
	令 \(x\to a\) 立即得到
	\[
	\lim_{x\to a}f(x)=f(a),
	\]
	因此 \(f\) 在 \(a\) 处连续。

\end{proof}

\textbf{附注}\quad 我们可以把\rthm{thm:caratheodory-derivative} 当作函数 \(f\) 在 \(a\) 处可导的定义，Carathéodory 在他的著作（Theory of Functions of a Complex Variable, vol.1 Chelsera, New York, 1954）中就是这样定义函数可导及导数的。我们可以称他的定义为 Carathéodory 导数定义以区别于 Cauchy 导数定义。

由于 \(\dfrac{f(x)-f(a)}{x-a}=\varphi(x)\) 正是联结函数 \(f\) 的曲线 \(\Gamma\) 上两点 \((a,f(a))\) 与 \((x,f(x))\) 的割线的斜率，故 Carathéodory 导数定义强调了此割线以连续方式接近 \(\Gamma\) 在 \((a,f(a))\) 处的切线。

另一方面，Carathéodory 导数定义正像上述推论所指出的，深刻揭示了在一点可导的函数的重要内在性质——函数在可导点处连续。

以后我们将看到，利用\rthm{thm:caratheodory-derivative} 或 Carathéodory 导数定义证明微分学的许多重要定理要比按 Cauchy 导数定义去证明更方便，论述更简洁。

下面我们看几个可导函数的例子。

\begin{sourceexample}{1}

	证明：\(\forall\,n\in\N\)，幂函数 \(x\longmapsto f(x)=x^n\)，\(x\in\R\) 在任一点 \(a\in\R\) 处可导，并且
	\[
	f'(a)=na^{n-1}.
	\]
	事实上，由于 \(\forall\,x\in\R\)，
	\[
	x^n-a^n=(x-a)(x^{n-1}+x^{n-2}a+\cdots+xa^{n-2}+a^{n-1}).
	\]
	所以对 \(x\neq a\)，
	\[
	\frac{x^n-a^n}{x-a}=x^{n-1}+x^{n-2}a+\cdots+xa^{n-2}+a^{n-1}.
	\]
	从而
	\[
	\lim_{x\to a}\frac{x^n-a^n}{x-a}=\lim_{x\to a}(x^{n-1}+x^{n-2}a+\cdots+xa^{n-2}+a^{n-1})=na^{n-1}.
	\]
	因此 \(f\) 在 \(a\) 处可导，并且
	\[
	f'(a)=na^{n-1}.
	\]

\end{sourceexample}

\begin{sourceexample}{2}

	设函数 \(f:\R\to\R\) 定义如下：
	\[
	f(x)=\begin{cases} x^p\sin\dfrac1x, & x\neq0, \\ 0, & x=0 \end{cases}\quad(p>1).
	\]
	证明：\(f\) 在 \(x=0\) 处可导，并且 \(f'(0)=0\)。

	事实上，\(\forall\,x\neq0\)，
	\[
	\lim_{x\to0}\frac{f(x)-f(0)}x=\lim_{x\to0}x^{p-1}\sin\frac1x=0.
	\]
	因此 \(f\) 在 \(x=0\) 处可导，并且
	\[
	f'(0)=0.
	\]

\end{sourceexample}

\begin{sourceexample}{3}

	证明：函数 \(x\longmapsto f(x)=|x|\)，\(x\in\R\) 在 \(x=0\) 处左、右可导，但在 \(x=0\) 处不可导。

	事实上，这时我们有
	\[
	\lim_{x\to0^-}\frac{f(x)-f(0)}{x-0}=\lim_{x\to0^-}\frac{-x}{x}=-1,
	\]
	\[
	\lim_{x\to0^+}\frac{f(x)-f(0)}{x-0}=\lim_{x\to0^+}\frac{x}{x}=1.
	\]
	故 \(f\) 在 \(x=0\) 处左、右可导，并且 \(f'(0^-)=-1\)，\(f'(0^+)=1\)。由于 \(f'(0^+)\neq f'(0^-)\)，故 \(f\) 在 \(x=0\) 处不可导。

\end{sourceexample}

\subsection{无穷大导数}

\begin{mydef*}{}

	设 \(f:X\to\R\) 是任一函数，\(a\in X\) 是 \(X\) 的一聚点，我们称 \(f\) 在 \(a\) 处有正（负）无穷大导数，记为 \(f'(a)=+\infty\ (-\infty)\)，如果
	\[
	\lim_{x\to a}\frac{f(x)-f(a)}{x-a}=+\infty\ (-\infty).
	\]

\end{mydef*}

类似地，我们可以定义下述四种类型的正负无穷大导数：\(f'(a^+)=+\infty\)，\(f'(a^+)=-\infty\)，\(f'(a^-)=+\infty\)，\(f'(a^-)=-\infty\)。

\begin{sourceexample}{4}

	证明：对符号函数 \(x\longmapsto\operatorname{sgn}(x)\)，\(x\in\R\) 有
	\[
	\operatorname{sgn}'(0^+)=+\infty,\qquad\operatorname{sgn}'(0^-)=+\infty.
	\]
	事实上，
	\[
	\lim_{x\to0^+}\frac{\operatorname{sgn}(x)-\operatorname{sgn}(0)}{x-0}=\lim_{x\to0^+}\frac{1-0}{x}=+\infty,
	\]
	\[
	\lim_{x\to0^-}\frac{\operatorname{sgn}(x)-\operatorname{sgn}(0)}{x-0}=\lim_{x\to0^-}\frac{-1-0}{x}=+\infty.
	\]

\end{sourceexample}

\begin{sourceexample}{5}

	证明：对函数 \(x\longmapsto f(x)=x^{\frac23}\)，\(x\in\R\) 有
	\[
	f'(0^+)=+\infty,\qquad f'(0^-)=-\infty.
	\]
	事实上
	\[
	\lim_{x\to0^+}\frac{f(x)-f(0)}{x-0}=\lim_{x\to0^+}\frac{x^{\frac23}}{x}=\lim_{x\to0^+}\frac1{x^{\frac13}}=+\infty,
	\]
	\[
	\lim_{x\to0^-}\frac{f(x)-f(0)}{x-0}=\lim_{x\to0^-}\frac{x^{\frac23}}{x}=\lim_{x\to0^-}\frac1{x^{\frac13}}=-\infty.
	\]
	因此 \(f'(0^+)=+\infty\)，\(f'(0^-)=-\infty\)。

\end{sourceexample}

