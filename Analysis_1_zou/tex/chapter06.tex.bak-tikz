\subsection{函数不定型极限的计算}

导数的一个重要应用就是可用计算导数的方法求很大一类函数不定型极限，即下面的 L'Hospital 法则。

\begin{mythm}{L'Hospital法则}{lhospital-rule}

	设 \(]a,b[\) 是任一开区间 \((-\infty\le a<b\le+\infty)\)，\(f,g:\ ]a,b[\to\R\) 是任意两个函数，满足下述条件：

	1) \(f,g\) 在 \(]a,b[\) 上可导，\(g'(x)\neq0\)，\(\forall\,x\in\ ]a,b[\)；

	2) \(\lim_{x\to a^+}f(x)=\lim_{x\to a^+}g(x)=0\ \text{或}\ \pm\infty\)；

	3) \(\lim_{x\to a^+}\dfrac{f'(x)}{g'(x)}=A\in\overline\R\)。

	则我们也有
	\[
	\lim_{x\to a^+}\frac{f(x)}{g(x)}=A.
	\]
	当 \(x\to b^-\) 时也有类似的结论。

\end{mythm}

\begin{proof}

	首先我们证明：存在 \(c\in\ ]a,b[\) 使得
	\[
	g(x)\neq0,\quad\forall\,x\in\ ]a,c[.
	\]
	事实上，由假设 \(g'(x)\neq0\)，\(\forall\,x\in\ ]a,b[\)，故由 Darboux 定理（\rthm{thm:darboux-theorem}）的推论知 \(g'(x)>0\)，\(\forall\,x\in\ ]a,b[\)，或 \(g'(x)<0\)，\(\forall\,x\in\ ]a,b[\)。从而 \(g\) 在 \(]a,b[\) 上是严格单调的，故不论 \(\lim_{x\to a^+}g(x)=0\) 或 \(\lim_{x\to a^+}g(x)=\pm\infty\)，我们总可以找到一个 \(c\in\ ]a,b[\)，使得 \(g(x)\neq0\)，\(\forall\,x\in\ ]a,c[\)。

	下面我们对 \(A\) 分三种情况来讨论：

	1) \(A<+\infty\)：任取 \(p,q\in\R\)，使得 \(A<p<q\)。

	由于 \(\lim_{x\to a^+}\dfrac{f'(x)}{g'(x)}=A\)，故存在 \(c_1\in\ ]a,c[\) 使得
	\[
	\frac{f'(x)}{g'(x)}<p<q,\quad\forall\,x\in\ ]a,c_1[.
	\]
	于是 \(\forall\,x,y\in\ ]a,c_1[\) 且 \(x\neq y\)，由 Cauchy 中值定理有
	\[
	\frac{f(x)-f(y)}{g(x)-g(y)}=\frac{f'(\xi)}{g'(\xi)}\quad(\xi\ \text{介于}\ x\ \text{与}\ y\ \text{之间}).
	\]
	由此得到
	\[
	\frac{f(x)-f(y)}{g(x)-g(y)}<p<q,\quad\forall\,x,y\in\ ]a,c_1[. \tag{*}
	\]
	若 \(\lim_{x\to a^+}f(x)=\lim_{x\to a^+}g(x)=0\)，则在 \((*)\) 中固定 \(x\in\ ]a,c_1[\)，并令 \(y\to a^+\) 得到
	\[
	\frac{f(x)}{g(x)}<q,\qquad\forall\,x\in\ ]a,c_1[.
	\]
	若 \(\lim_{x\to a^+}f(x)=\lim_{x\to a^+}g(x)=\pm\infty\)，则由于 \(\lim_{x\to a^+}\dfrac{1-f(y)/f(x)}{1-g(y)/g(x)}=1\)（这里固定 \(y\in\ ]a,c_1[\)），故有 \(\dfrac{1-f(y)/f(x)}{1-g(y)/g(x)}=1+o(1)\ (x\to a^+)\)。从而由 \((*)\) 式得到
	\[
	\frac{f(x)\bigl[1-f(y)/f(x)\bigr]}{g(x)\bigl[1-g(y)/g(x)\bigr]}=\frac{f(x)}{g(x)}\bigl[1+o(1)\bigr]<p
	\]
	\[
	\text{或}\quad\frac{f(x)}{g(x)}<\frac{p}{1+o(1)}\quad(x\to a^+).
	\]
	于是存在 \(c_2\in\ ]a,c_1[\) 使得 \(\dfrac{p}{1+o(1)}<q\)，或
	\[
	\frac{f(x)}{g(x)}<q,\quad\forall\,x\in\ ]a,c_2[.
	\]
	总之不论 \(\lim_{x\to a^+}f(x)=\lim_{x\to a^+}g(x)=0\) 或 \(\pm\infty\)，我们证明了下述结论：
	\[
	(\forall\,q>A)(\exists\,c_q>a)(\forall\,x\in\ ]a,c_q[)\Longrightarrow\frac{f(x)}{g(x)}<q. \tag{**}
	\]
	因此当 \(A=-\infty\) 时，\(\forall\,M>0\)，若取 \(q=-M\)，则 \((**)\) 式表明
	\[
	\lim_{x\to a^+}\frac{f(x)}{g(x)}=A=-\infty.
	\]
	2) \(A>-\infty\)：任取 \(\bar p,\bar q\in\R\) 使得 \(\bar q<\bar p<A\)。

	这时我们可类似证明下述结论成立：
	\[
	(\forall\,\bar q<A)(\exists\,c_{\bar q}>a)(\forall\,x\in\ ]a,c_{\bar q}[)\Longrightarrow\frac{f(x)}{g(x)}>\bar q. \tag{***}
	\]
	因此当 \(A=+\infty\) 时，\(\forall\,M>0\)，若取 \(\bar q=M\)，则上述 \((***)\) 式表明
	\[
	\lim_{x\to a^+}\frac{f(x)}{g(x)}=A=+\infty.
	\]
	3) \(-\infty<A<+\infty\)：这时 \(\forall\,\varepsilon>0\)，若取 \(q=A+\varepsilon\)，\(\bar q=A-\varepsilon\)，则存在 \(d=\min(c_q,c_{\bar q})\) 使得
	\[
	\forall\,x\in\ ]a,d[\ \Longrightarrow\ A-\varepsilon<\frac{f(x)}{g(x)}<A+\varepsilon.
	\]
	此即表明
	\[
	\lim_{x\to a^+}\frac{f(x)}{g(x)}=A.
	\]
	对 \(x\to b^-\) 的情形可类似证明。

\end{proof}

\textbf{附注}\quad 上述 L'Hospital 法则解决了函数的 \(\dfrac00\) 与 \(\dfrac\infty\infty\) 不定型的极限计算问题。\(0\cdot\infty\) 与 \(\infty-\infty\) 不定型我们在第 4 章 §3 中已经证明了通过适当处理都可以化为 \(\dfrac00\) 或 \(\dfrac\infty\infty\) 不定型，至于函数的 \(1^\infty\)，\(0^0\)，\(\infty^0\) 不定型，通过先取自然对数的方法也可以把它们化为 \(0\cdot\infty\) 不定型。例如设 \(u(x)^{v(x)}\) 是 \(0^0\) 不定型，
\[
\log u(x)^{v(x)}=v(x)\log u(x)
\]
就是 \(0\cdot\infty\) 不定型。

因此我们可以说，L'Hospital 法则原则上完全解决了函数的所有不定型极限的计算问题。

下面举几个例子说明 L'Hospital 法则的应用。

\begin{sourceexample}{10}

	计算 \(\displaystyle\lim_{x\to0}\frac{e^x-e^{-x}}{\sin x}\)。

	这是 \(\dfrac00\) 不定型。它满足 L'Hospital 法则的全部条件，并且
	\[
	\lim_{x\to0}\frac{(e^x-e^{-x})'}{(\sin x)'}=\lim_{x\to0}\frac{e^x+e^{-x}}{\cos x}=2.
	\]
	因此
	\[
	\lim_{x\to0}\frac{e^x-e^{-x}}{\sin x}=2.
	\]

\end{sourceexample}

\begin{sourceexample}{11}

	计算 \(\displaystyle\lim_{x\to1}\frac{x^x-x}{\log x-x+1}\)。

	这是 \(\dfrac00\) 不定型。计算这个极限时，我们必须重复应用 L'Hospital 法则。
	\[
	\lim_{x\to1}\frac{x^x-x}{\log x-x+1}
	=\lim_{x\to1}\frac{x^x(1+\log x)-1}{\dfrac1x-1}
	\]
	\[
	=\lim_{x\to1}\frac{x^{x+1}(1+\log x)-x}{1-x}
	=\lim_{x\to1}x\cdot\lim_{x\to1}\frac{x^x(1+\log x)-1}{1-x}
	\]
	\[
	=\lim_{x\to1}\frac{x^x\left[(1+\log x)^2+\dfrac1x\right]}{-1}=-2.
	\]

\end{sourceexample}

\begin{sourceexample}{12}

	计算 \(\displaystyle\lim_{x\to+\infty}\frac{\log x}{x^\alpha}\)，\(\displaystyle\lim_{x\to+\infty}\frac{x^\alpha}{a^x}\quad(\alpha>0,\ a>1)\)。

	它们都是 \(\dfrac\infty\infty\) 不定型。由 L'Hospital 法则得到
	\[
	\lim_{x\to+\infty}\frac{\log x}{x^\alpha}
	=\lim_{x\to+\infty}\frac{\dfrac1x}{\alpha x^{\alpha-1}}
	=\lim_{x\to+\infty}\frac1{\alpha x^\alpha}=0.
	\]
	对于 \(\dfrac{x^\alpha}{a^x}\)，由于 \(\alpha>0\) 是一定数，故存在 \(n\in\N\) 使得 \(\alpha-n\le0\)。因此对 \(\dfrac{x^\alpha}{a^x}\) 应用 \(n\) 次 L'Hospital 法则得到
	\[
	\lim_{x\to+\infty}\frac{x^\alpha}{a^x}
	=\lim_{x\to+\infty}\frac{\alpha x^{\alpha-1}}{a^x\log a}
	=\lim_{x\to+\infty}\frac{\alpha(\alpha-1)x^{\alpha-2}}{a^x(\log a)^2}
	=\cdots
	\]
	\[
	=\lim_{x\to+\infty}\frac{\alpha(\alpha-1)\cdots(\alpha-n+1)x^{\alpha-n}}{a^x(\log a)^n}=0.
	\]

\end{sourceexample}

\begin{sourceexample}{13}

	设 \(\alpha>0\)，计算 \(\displaystyle\lim_{x\to0^+}x^\alpha\log x\)。

	这是 \(0\cdot\infty\) 不定型。我们把它化为 \(\dfrac\infty\infty\) 不定型。
	\[
	\lim_{x\to0^+}x^\alpha\log x=\lim_{x\to0^+}\frac{\log x}{x^{-\alpha}}=\lim_{x\to0^+}\frac{\dfrac1x}{(-\alpha)x^{-\alpha-1}}
	\]
	\[
	=\lim_{x\to0^+}\frac{x^\alpha}{-\alpha}=0.
	\]

\end{sourceexample}

\begin{sourceexample}{14}

	计算 \(\displaystyle\lim_{x\to0^+}x^{\frac1{1+\log x}}\)。

	这是 \(0^0\) 不定型。由 \(\log x^{\frac1{1+\log x}}=\dfrac{\log x}{1+\log x}\) 得到
	\[
	\lim_{x\to0^+}\log x^{\frac1{1+\log x}}=\lim_{x\to0^+}\frac{\log x}{1+\log x}=\lim_{x\to0^+}\frac{\dfrac1x}{\dfrac1x}=1.
	\]
	从而
	\[
	\lim_{x\to0^+}x^{\frac1{1+\log x}}=\lim_{x\to0^+}e^{\log x^{\frac1{1+\log x}}}=e.
	\]

\end{sourceexample}

\subsection*{习 题}

\begin{exercise}
	\item 证明下述各不等式：
	\begin{enumerate}[label=\arabic*)]
		\item \(x<\arcsin x<\dfrac{x}{\sqrt{1-x^2}}\quad(0<x<1)\)。
		\item \(\log(1+x)>\dfrac{\operatorname{arctg}x}{1+x}\quad(x>0)\)。
		\item \(\displaystyle\int_a^b\frac1{x\log x}dx<\frac{2b}{\log b}\quad(e^2<a<b)\)。
		\item \(\displaystyle e^x<\frac1{1-x}\quad(x<1)\)。
		\item \((x^\alpha+y^\alpha)^{\frac1\alpha}<(x^\beta+y^\beta)^{\frac1\beta}\quad(x>0,\ y>0,\ \beta>\alpha>0)\)。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 证明下述恒等式：
	\[
	\forall\,x\in\R,\quad\int_0^{\sin^2x}\arcsin\sqrt t\,dt+\int_0^{\cos^2x}\arccos\sqrt t\,dt=\frac\pi4.
	\]
\end{exercise}

\begin{exercise}
	\item 设函数 \(f:[a,b]\to\R\) 在点 \(c\in\ ]a,b[\) 的邻域 \(B(c,\delta)\) 上可导，并且 \(f'\) 在 \(c\) 处连续，\(f'(c)\neq0\)。证明：存在 \(0<\eta\le\delta\)，使得 \(f\) 在 \(B(c,\eta)\) 上是单调的。

	若 \(f'\) 在 \(c\) 处不连续，则上述结论可以不成立。试研究函数
	\[
	x\longmapsto f(x)=\begin{cases} \dfrac x2+x^2\sin\dfrac1x, & x\neq0, \\[6pt] 0, & x=0. \end{cases}
	\]
	\begin{enumerate}[label=\arabic*)]
		\item 证明：函数
		\[
		x\longmapsto g(x)=\begin{cases} x^2\sin\dfrac1x, & x\neq0, \\[6pt] 0, & x=0 \end{cases}
		\]
		在 \(x=0\) 的任意邻域内既有 \(g'(x)=1\) 的 \(x\) 又有 \(g'(x)=-1\) 的 \(x\)。
		\item 证明：在 \(x=0\) 的任意邻域内既有 \(f'(x)>0\) 的 \(x\) 又有 \(f'(x)<0\) 的 \(x\)。
		\item 由此推出 \(f\) 在 \(x=0\) 的任意邻域内都不是单调的。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \([a,b]\subset\R\)，\(f:[a,b]\to\R\) 是任一函数，满足下述条件：
	\begin{enumerate}[label=\arabic*)]
		\item \(f\) 在 \([a,b]\) 上连续；
		\item \(\forall\,x\in\ ]a,b[\)，\(f'(x^+)\) 与 \(f'(x^-)\) 中至少有一个存在，并且非负（可以为 \(+\infty\)）。
	\end{enumerate}
	证明：\(f\) 在 \([a,b]\) 上是单调上升函数。为此，
	\begin{enumerate}[label=\arabic*)]
		\item 假设存在 \(\alpha,\beta\in[a,b]\)，\(\alpha<\beta\) 使得 \(f(\alpha)>f(\beta)\)。考虑直线 \(y_k(x)=-k(x-\alpha)+f(\alpha)\)，证明存在 \(k_0>0\) 使得 \(y_{k_0}(\beta)>f(\beta)\)。
		\item 令 \(E=\{x\in[\alpha,\beta]\mid f(x)=y_{k_0}(x)\}\)，\(\xi=\sup E\)。证明：\(f'(\xi^+)<0\)，\(f'(\xi^-)<0\)。
		\item 由此推出 \(f\) 在 \([a,b]\) 上单调上升。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设函数 \(f:[a,b]\to\R\) 在 \([a,b]\) 上连续，并且 \(\forall\,x\in\ ]a,b[\)，\(f'(x^+)\) 与 \(f'(x^-)\) 中有一个存在，记它为 \(f'(x^\varepsilon)\ (\varepsilon=\pm)\)。试利用第 3 题的结论证明
	\[
	\inf_{x\in\ ]a,b[}f'(x^\varepsilon)\le\frac{f(b)-f(a)}{b-a}\le\sup_{x\in\ ]a,b[}f'(x^\varepsilon).
	\]
\end{exercise}

\begin{exercise}
	\item 证明：函数 \(x\longmapsto\log\left(\dfrac{x}{\sin x}\right)\)，\(0<x<\dfrac\pi2\) 是凸的。
\end{exercise}

\begin{exercise}
	\item 证明：函数
	\[
	x\longmapsto\begin{cases} (x-2)^2, & x\in[0,+\infty[, \\ (x+2)^2, & x\in\ ]-\infty,0] \end{cases}
	\]
	在 \(]-\infty,0]\) 与 \([0,+\infty[\) 是凸的，但 \(f\) 在 \(\R\) 上不是凸的。
\end{exercise}

\begin{exercise}
	\item 设函数 \(f:I\to J\) 与 \(g:J\to\R\) 是凸函数，并且 \(g\) 是单调上升的，证明：\(g\circ f:I\to\R\) 也是凸函数。
\end{exercise}

\begin{exercise}
	\item 设函数 \(f:I\to\R\) 满足条件（\(I\) 为一区间）：
	\[
	f\left(\frac{x+y}{2}\right)\le\frac12[f(x)+f(y)],\quad\forall\,x,y\in I.
	\]
	\begin{enumerate}[label=\arabic*)]
		\item 证明：\(\forall\,k=\dfrac m{2^n}\in[0,1],\ f(kx+(1-k)y)\le kf(x)+(1-k)f(y)\)。
		\item 证明：若 \(f\) 在 \(I\) 上连续，则 \(f\) 是凸的。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \(f:I\to\R\) 是任一凸函数（\(I\) 是一有限闭区间）。
	\begin{enumerate}[label=\arabic*)]
		\item 证明：\(\forall\,\alpha,\beta\in\R\)，\(\alpha<\beta\)，并且 \([\alpha,\beta]\subset\mathring I\)，\(f\) 在 \([\alpha,\beta]\) 上是 Lipschitz 函数。
		\item 证明：\(f\) 在 \(\mathring I\) 上连续。
		\item 举例说明凸函数 \(f:I\to\R\) 在 \(I\) 上不一定连续。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \(f:I\to\R\) 是任一凸函数。
	\begin{enumerate}[label=\arabic*)]
		\item 证明：\(\forall\,x\in I\)，\(f'(x^+)\) 与 \(f'(x^-)\) 存在并且 \(f'(x^-)\le f'(x^+)\)。
		\item 证明：函数 \(x\longmapsto f'(x^-)\) 与 \(x\longmapsto f'(x^+)\)，\(x\in\mathring I\) 是单调上升的，并且
		\[
		\forall\,a,b\in\mathring I,\quad f'(a^+)\le\frac{f(b)-f(a)}{b-a}\le f'(b^-).
		\]
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \(I\) 是任一非空开区间，\(f:I\to\R\) 是任一函数。证明：\(f\) 是凸的充分必要条件是 \(f\) 在 \(I\) 上连续并且在 \(I\) 上有单调上升的左、右导函数存在。
\end{exercise}

\begin{exercise}
	\item 设 \(I\) 是任一开区间，\(f:I\to\R\) 是任一函数。
	\begin{enumerate}[label=\arabic*)]
		\item 设 \(a\in I\)，\(f\) 是凸的。证明：\(f\) 的图形 \(\Gamma\) 位于方程为 \(y=f(a)+m(x-a)\) 的直线的上方，当且仅当 \(f'(a^-)\le m\le f'(a^+)\)。
		\item 设 \(f\) 在 \(I\) 上连续，右（或左）可导，且满足下述不等式：
		\[
		\forall\,a,x\in I,\quad f(x)\ge f(a)+f'(a^+)(x-a)
		\]
		\[
		(f(x)\ge f(a)+f'(a^-)(x-a)).
		\]
		证明：\(f\) 是凸的。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \(f:\ ]a,b[\to\R\) 是 \(C^1\) 类的，并且是严格凸的（即 \(\forall\,x_1,x_2\in\ ]a,b[\)，\(\forall\,\alpha_1,\alpha_2\in[0,1]\) 且 \(\alpha_1+\alpha_2=1\) 满足：
	\[
	f(\alpha_1x_1+\alpha_2x_2)<\alpha_1f(x_1)+\alpha_2f(x_2)).
	\]
	\begin{enumerate}[label=\arabic*)]
		\item 证明：\(f\) 的图形 \(\Gamma\) 上的每一点的切线的斜率所组成的实数集合是一开区间 \(J\)。
		\item 证明：\(f':\ ]a,b[\to J\) 是可逆的，记 \(k:J\to\ ]a,b[\) 为 \(f'\) 的反函数。
		\item \(\forall\,\lambda\in J\)，定义函数 \(h_\lambda:\ ]a,b[\to\R\) 如下：
		\[
		h_\lambda(x)=\lambda x-f(x),\quad\forall\,x\in\ ]a,b[.
		\]
		证明：\(h_\lambda\) 在 \(]a,b[\) 上有唯一的极大值点，记它为 \(x_\lambda\)。
		\item 定义函数 \(g:J\to\R\) 如下：
		\[
		g(\lambda)=h_\lambda(x_\lambda)=\sup_{x\in\ ]a,b[}(\lambda x-f(x)),\quad\forall\,\lambda\in J.
		\]
		试找出函数 \(f,k,g\) 所满足的关系式。
		\item 证明：\(g\) 在 \(J\) 上连续。
		\item 证明：\(g\) 在 \(J\) 上是凸函数。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设函数 \(f:[a,b]\to\R\) 在 \([a,b]\) 上 2 次可导，证明：\(\forall\,x\in\ ]a,b[\)，
	\[
	f''(x)=\lim_{h\to0}\frac{f(x+h)+f(x-h)-2f(x)}{h^2}.
	\]
\end{exercise}

\begin{exercise}
	\item 计算下列各极限值：
	\begin{enumerate}[label=\arabic*)]
		\item \(\displaystyle\lim_{x\to0}\frac{x-\operatorname{tg}x}{x^3}\)；
		\item \(\displaystyle\lim_{x\to0}\frac{xe^x-\log(1+x)}{x^2}\)；
		\item \(\displaystyle\lim_{x\to0}\sin x\log x\)；
		\item \(\displaystyle\lim_{x\to1}\left(\frac1{\log x}-\frac1{x-1}\right)\)；
		\item \(\displaystyle\lim_{x\to0}\left[\frac1{\log(x+\sqrt{1+x^2})}-\frac1{\log(1+x)}\right]\)；
		\item \(\displaystyle\lim_{x\to1^-}(1-x^2)^{\frac1{\log(1-x)}}\)；
		\item \(\displaystyle\lim_{x\to0}\left(\frac{\operatorname{tg}x}{x}\right)^{\frac1{x^2}}\)；
		\item \(\displaystyle\lim_{x\to0}\left(\frac{\cos x}{\operatorname{ch}x}\right)^{-\frac1{x^2}}\)；
		\item \(\displaystyle\lim_{x\to0^+}(\operatorname{ctg}x)^{\sin x}\)；
		\item \(\displaystyle\lim_{x\to\frac\pi2}(\sin x)^{\operatorname{tg}x}\)。
	\end{enumerate}
\end{exercise}

