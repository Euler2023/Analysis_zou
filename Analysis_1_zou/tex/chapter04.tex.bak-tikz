\chapter{一元实值函数的极限}

这一章我们介绍一元实值函数的极限概念及其性质，特别研究了一类重要函数——连续函数的若干特性。

\section{函数极限的定义}

设 \(f\) 是任一映射。若
\[
\operatorname{Dom}(f)=X\subset\R,\qquad \operatorname{Ran}(f)\subset\R,
\]
则今后我们称 \(f:X\to\R\) 为一元实值函数，或简称为一元函数或函数。

\subsection{\texorpdfstring{\((a,A)\) 型函数极限}{(a,A) 型函数极限}}

\begin{mydef*}{}

	设 \(f:X\to\R\) 是任一函数，\(a\in\R\) 是 \(X\) 的一个聚点，\(A\in\R\) 是一定数。

	\begin{enumerate}[label=\arabic*)]
		\item 我们称函数 \(f\) 当 \(x\) 趋于 \(a\) 时极限存在并以 \(A\) 为极限，如果下述性质成立：
		\[
		(\forall\,\varepsilon>0)\,(\exists\,\delta>0)\,(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow |f(x)-A|<\varepsilon.
		\]
		这时，记为
		\[
		\lim_{x\to a}f(x)=A \quad\text{或}\quad f(x)\to A\ (x\to a).
		\]

		\item 我们称函数 \(f\) 当 \(x>a\) 且趋于 \(a\) 时右极限存在并以 \(A\) 为右极限，如果 \(a\) 是右侧聚点，并且下述性质成立：
		\[
		(\forall\,\varepsilon>0)\,(\exists\,\delta>0)\,(\forall\,x\in X\cap\mathring{B}_+(a,\delta))\Longrightarrow |f(x)-A|<\varepsilon.
		\]
		这时，记为
		\[
		\lim_{x\to a^+}f(x)=A=f(a^+) \quad\text{或}\quad f(x)\to A=f(a^+)\ (x\to a^+).
		\]

		\item 我们称函数 \(f\) 当 \(x<a\) 且趋于 \(a\) 时左极限存在并以 \(A\) 为左极限，如果 \(a\) 是左侧聚点，并且下述性质成立：
		\[
		(\forall\,\varepsilon>0)\,(\exists\,\delta>0)\,(\forall\,x\in X\cap\mathring{B}_-(a,\delta))\Longrightarrow |f(x)-A|<\varepsilon.
		\]
		这时，记为
		\[
		\lim_{x\to a^-}f(x)=A=f(a^-) \quad\text{或}\quad f(x)\to A=f(a^-)\ (x\to a^-).
		\]
	\end{enumerate}

\end{mydef*}

\textbf{附注}\quad 1) 由于 \(|f(x)-A|<\varepsilon\) 等价于 \(f(x)\in B(A,\varepsilon)\)，故上述三个极限定义可表示为下面的形式：
\[
\lim_{x\to a}f(x)=A \Longleftrightarrow (\forall\,\varepsilon>0)(\exists\,\delta>0)\Longrightarrow f(X\cap\mathring{B}(a,\delta))\subset B(A,\varepsilon),
\]
\[
\lim_{x\to a^+}f(x)=A \Longleftrightarrow (\forall\,\varepsilon>0)(\exists\,\delta>0)\Longrightarrow f(X\cap\mathring{B}_+(a,\delta))\subset B(A,\varepsilon),
\]
\[
\lim_{x\to a^-}f(x)=A \Longleftrightarrow (\forall\,\varepsilon>0)(\exists\,\delta>0)\Longrightarrow f(X\cap\mathring{B}_-(a,\delta))\subset B(A,\varepsilon).
\]

2) 从上面的三个极限定义可以看出，极限 \(\lim_{x\to a}f(x)=A\)（\(\lim_{x\to a^+}f(x)=A\)，\(\lim_{x\to a^-}f(x)=A\)）反映的是函数 \(f\) 当 \(x\to a\)（\(x\to a^+\) 或 \(x\to a^-\)）时的变化趋势。因此 \(a\) 是否属于 \(X\) 无关紧要，即使 \(a\in X\)，函数 \(f\) 当 \(x\to a\)（\(a^+\) 或 \(a^-\)）时也不一定有向 \(f(a)\) 变化的趋势。

3) 从几何意义上来看，\(\lim_{x\to a}f(x)=A\) 表示 \(\forall\,\varepsilon>0\)，总能找到一个 \(\delta>0\)，使得函数 \(f\) 在集合 \(X\cap\mathring{B}(a,\delta)\) 上的限制 \(f|_{X\cap\mathring{B}(a,\delta)}\) 的图形包含在平面长方形区域 \([a-\delta,a+\delta]\times[A-\varepsilon,A+\varepsilon]\) 的内部，即
\[
\{(x,y)\in\R^2 \mid x\in X\cap\mathring{B}(a,\delta),\ y=f(x)\}\subset\ ]a-\delta,a+\delta[\ \times\ ]A-\varepsilon,A+\varepsilon[.
\]

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_135_Figure_9.jpeg}
	\caption{}
	\label{fig:4-1}
\end{figure}

下面我们来看几个函数极限的例子。

\begin{sourceexample}{1}

	考虑如下定义的函数 \(f:\R-\{0\}\to\R\) 与函数 \(g:\R\to\R\)：
	\[
	f(x)=\begin{cases} x, & \forall\,x>0, \\ -x, & \forall\,x<0, \end{cases}
	\qquad
	g(x)=\begin{cases} x, & \forall\,x>0, \\ 1, & x=0, \\ -x, & \forall\,x<0. \end{cases}
	\]

	由于 \(\forall\,x\in\R-\{0\},\ |f(x)-0|=|g(x)-0|=|x|\)。故
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta=\varepsilon>0)(\forall\,x\in\mathring{B}(0,\delta))\Longrightarrow
	\begin{cases} |f(x)-0|<\varepsilon, \\ |g(x)-0|<\varepsilon. \end{cases}
	\]
	因此
	\[
	\lim_{x\to0}f(x)=0,\qquad \lim_{x\to0}g(x)=0.
	\]
	这里 \(0\notin\operatorname{Dom}(f),\,0\in\operatorname{Dom}(g)\)，但 \(0\neq g(0)\)。

\end{sourceexample}

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_136_Figure_5.jpeg}
	\caption{}
	\label{fig:4-2}
\end{figure}

\begin{sourceexample}{2}

	考虑函数 \(x\mapsto x^p\sin\dfrac{1}{x},\ x\in\R-\{0\},\ (p>0)\) 证明：
	\[
	\lim_{x\to0}x^p\sin\frac{1}{x}=0.
	\]

	事实上，\(\forall\,x\in\R-\{0\}\)，我们有
	\[
	\left|x^p\sin\frac{1}{x}-0\right|\le|x|^p.
	\]
	\(\forall\,\varepsilon>0\)，由 \(|x|^p<\varepsilon\) 得到 \(|x|<\sqrt[p]{\varepsilon}\)，令 \(\delta=\sqrt[p]{\varepsilon}\)，则
	\[
	\forall\,x\in\mathring{B}(0,\delta)\Longrightarrow \left|x^p\sin\frac{1}{x}-0\right|\le|x|^p<\varepsilon.
	\]
	因此 \(\lim_{x\to0}x^p\sin\dfrac{1}{x}=0\)。

\end{sourceexample}

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_137_Figure_0.jpeg}
	\caption{}
	\label{fig:4-3}
\end{figure}

\begin{sourceexample}{3}

	考虑符号函数
	\[
	x\mapsto\operatorname{sgn}(x)=\begin{cases} 1, & \forall\,x>0, \\ 0, & x=0, \\ -1, & \forall\,x<0. \end{cases}
	\]

	证明：普通极限 \(\lim_{x\to0}\operatorname{sgn}(x)\) 不存在，而
	\[
	\lim_{x\to0^+}\operatorname{sgn}(x)=1,\qquad \lim_{x\to0^-}\operatorname{sgn}(x)=-1.
	\]
	事实上，若 \(\lim_{x\to0}\operatorname{sgn}(x)=A\)，则
	\[
	(\forall\,0<\varepsilon<1)(\exists\,\delta>0)(\forall\,x\in\mathring{B}(0,\delta))\Longrightarrow|\operatorname{sgn}(x)-A|<\varepsilon
	\]
	\[
	\Longrightarrow 2\le|1-A|+|A-(-1)|<2\varepsilon
	\]
	\[
	\Longrightarrow \varepsilon>1,
	\]
	这与 \(\varepsilon<1\) 的假设相矛盾，因此 \(\lim_{x\to0}\operatorname{sgn}(x)\) 不存在。

	但是由于 \(\forall\,x>0,\ \operatorname{sgn}(x)=1\)；\(\forall\,x<0,\ \operatorname{sgn}(x)=-1\)，故
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta=\varepsilon>0)\begin{cases}
	(\forall\,x\in\mathring{B}_+(0,\delta))\Longrightarrow|\operatorname{sgn}(x)-1|=0<\varepsilon, \\
	(\forall\,x\in\mathring{B}_-(0,\delta))\Longrightarrow|\operatorname{sgn}(x)-(-1)|=0<\varepsilon.
	\end{cases}
	\]
	因此 \(\lim_{x\to0^+}\operatorname{sgn}(x)=1,\ \lim_{x\to0^-}\operatorname{sgn}(x)=-1\)。

\end{sourceexample}

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_138_Picture_0.jpeg}
	\caption{}
	\label{fig:4-4}
\end{figure}

例 3 实际上揭示了下面的一般结论，即

\begin{mythm}{}{limit-equals-one-sided-limits}

	设 \(f:X\to\R\) 是任一函数，\(a\in\R\) 是 \(X\) 的一个双侧聚点，那末
	\[
	\lim_{x\to a}f(x)=A \Longleftrightarrow \lim_{x\to a^+}f(x)=\lim_{x\to a^-}f(x)=A.
	\]

\end{mythm}

\begin{proof}

	必要性\quad 设 \(\lim_{x\to a}f(x)=A\)。那末由定义
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow |f(x)-A|<\varepsilon.
	\]
	特别地
	\[
	\forall\,x\in X\cap\mathring{B}_+(a,\delta)\Longrightarrow |f(x)-A|<\varepsilon,
	\]
	\[
	\forall\,x\in X\cap\mathring{B}_-(a,\delta)\Longrightarrow |f(x)-A|<\varepsilon.
	\]
	因此 \(\lim_{x\to a^+}f(x)=A,\ \lim_{x\to a^-}f(x)=A\)。

	充分性\quad 设 \(\lim_{x\to a^+}f(x)=\lim_{x\to a^-}f(x)=A\)，由定义有
	\[
	(\forall\,\varepsilon>0)\begin{cases}
	(\exists\,\delta_1>0)(\forall\,x\in X\cap\mathring{B}_+(a,\delta_1))\Longrightarrow |f(x)-A|<\varepsilon, \\
	(\exists\,\delta_2>0)(\forall\,x\in X\cap\mathring{B}_-(a,\delta_2))\Longrightarrow |f(x)-A|<\varepsilon.
	\end{cases}
	\]
	令 \(\delta=\min(\delta_1,\delta_2)\)，则 \(\delta>0\)，并且
	\[
	\forall\,x\in X\cap\mathring{B}(a,\delta)\Longrightarrow |f(x)-A|<\varepsilon.
	\]
	因此 \(\lim_{x\to a}f(x)=A\)。

\end{proof}

为了进一步理解函数的 \((a,A)\) 型极限的定义，我们再考虑下面两个例子。

\begin{sourceexample}{4}

	考虑所谓的 Dirichlet 函数
	\[
	x\longmapsto D(x)=\begin{cases} 1, & x\in\Q, \\ 0, & x\in\Q^c. \end{cases}
	\]

	证明：\(\forall\,a\in\R,\ \lim_{x\to a}D(x)\) 不存在。

	事实上，若存在 \(a_0\in\R\) 使得 \(\lim_{x\to a_0}D(x)=l\in\R\)，则
	\[
	\left(\forall\,0<\varepsilon<\frac12\right)(\exists\,\delta>0)(\forall\,x\in\mathring{B}(a_0,\delta)\Longrightarrow|D(x)-l|<\varepsilon.
	\]
	于是特别有
	\[
	\forall\,x\in\mathring{B}(a_0,\delta)\cap\Q,\quad |D(x)-l|=|1-l|<\varepsilon,
	\]
	\[
	\forall\,x\in\mathring{B}(a_0,\delta)\cap\Q^c,\quad |D(x)-l|=|0-l|<\varepsilon.
	\]
	由此推得
	\[
	1=|1-l+l|\le|1-l|+|l|<2\varepsilon,
	\]
	或 \(\varepsilon>\dfrac12\)，这与 \(0<\varepsilon<\dfrac12\) 假设矛盾。故 \(\forall\,a\in\R,\ \lim_{x\to a}D(x)\) 不存在。

\end{sourceexample}

\begin{sourceexample}{5}

	考虑如下定义的 Riemann 函数 \(R\)：
	\[
	R(x)=\begin{cases}
	0, & \text{若 }x\in\Q^c, \\
	1, & \text{若 }x=0, \\
	\dfrac1p, & \text{若 }x=\dfrac qp,\ p\in\N,\ p\text{ 与 }q\text{ 互质}.
	\end{cases}
	\]

	证明：\(\forall\,a\in\R,\ \lim_{x\to a}R(x)=0\)。

	为此任取 \(a\in\R\)。

	若 \(a=0\)；则 \(\forall\,\delta>0\)，
	\[
	R(x)=\begin{cases}
	0, & \forall\,x\in\mathring{B}(0,\delta)\cap\Q^c, \\
	\dfrac1p, & \substack{\forall\,x\in\mathring{B}(0,\delta)\cap\Q,\quad x=\dfrac qp, \\ p\in\N,\quad p,q\text{ 互质}.}
	\end{cases}
	\]

	若 \(a\neq0\)：则存在 \(\delta_0>0\) 使得 \(0\notin\mathring{B}(a,\delta_0)\)，于是
	\[
	R(x)=\begin{cases}
	0, & \forall\,x\in\mathring{B}(a,\delta_0)\cap\Q^c, \\
	\dfrac1p, & \substack{\forall\,x\in\mathring{B}(a,\delta_0)\cap\Q,\quad x=\dfrac qp, \\ p\in\N,\quad p,q\text{ 互质}.}
	\end{cases}
	\]

	由此可知，不论 \(a=0\) 与否，
	\[
	R(x)=\begin{cases}
	0, & \forall\,x\in\mathring{B}(a,\delta_0)\cap\Q^c, \\
	\dfrac1p, & \substack{\forall\,x\in\mathring{B}(a,\delta_0)\cap\Q,\quad x=\dfrac qp, \\ p\in\N,\quad p,q\text{ 互质}.}
	\end{cases}
	\]

	\(\forall\,\varepsilon>0\)，由 \(\dfrac1p\ge\varepsilon\) 知 \(p\le\dfrac1\varepsilon\)。显然在 \(\mathring{B}(a,\delta_0)\) 中分母 \(p\le\dfrac1\varepsilon\) 的有理数 \(\dfrac qp\) 只有有限多个。因此存在 \(0<\delta<\delta_0\)，使得在 \(\mathring{B}(a,\delta)\) 中所有有理数 \(\dfrac qp\) 的分母 \(p>\dfrac1\varepsilon\)。从而
	\[
	\forall\,x\in\mathring{B}(a,\delta)\cap\Q,\quad x=\frac qp,\ p\in\N,\ p,q\text{ 互质}
	\]
	\[
	\Longrightarrow |R(x)|=\frac1p<\varepsilon.
	\]
	上述分析表明：\(\forall\,\varepsilon>0,\ \exists\,\delta>0\) 使得 \(\forall\,x\in\mathring{B}(a,\delta),\ |R(x)-0|<\varepsilon\)。

	因此 \(\lim_{x\to a}R(x)=0\)。

\end{sourceexample}

\subsection{\texorpdfstring{\((\pm\infty,A)\) 型函数极限}{（正负无穷, A）型函数极限}}

\begin{mydef*}{}

	设 \(f:X\to\R\) 是任一函数，\(A\in\R\)。

	\begin{enumerate}[label=\arabic*)]
		\item 设 \(+\infty\) 是 \(X\) 的无穷远聚点。我们称函数 \(f\) 当 \(x\) 趋于 \(+\infty\) 时极限存在并且以 \(A\) 为极限，如果下述性质成立：
		\[
		(\forall\,\varepsilon>0)(\exists\,M>0)(\forall\,x\in X\cap\ ]M,+\infty[)\Longrightarrow |f(x)-A|<\varepsilon.
		\]
		这时，记为
		\[
		\lim_{x\to+\infty}f(x)=A \quad\text{或}\quad f(x)\to A\ (x\to+\infty).
		\]

		\item 设 \(-\infty\) 是 \(X\) 的无穷远聚点，我们称函数 \(f\) 当 \(x\) 趋于 \(-\infty\) 时极限存在并且以 \(A\) 为极限，如果下述性质成立：
		\[
		(\forall\,\varepsilon>0)(\exists\,M>0)(\forall\,x\in X\cap\ ]-\infty,-M[)\Longrightarrow |f(x)-A|<\varepsilon.
		\]
		这时，记为
		\[
		\lim_{x\to-\infty}f(x)=A \quad\text{或}\quad f(x)\to A\ (x\to-\infty).
		\]
	\end{enumerate}

\end{mydef*}

我们也可用邻域语言表述这两类极限定义：
\[
\lim_{x\to+\infty}f(x)=A \Longleftrightarrow (\forall\,\varepsilon>0)(\exists\,M>0),\ f(X\cap\ ]M,+\infty[)\subset B(A,\varepsilon),
\]
\[
\lim_{x\to-\infty}f(x)=A \Longleftrightarrow (\forall\,\varepsilon>0)(\exists\,M>0),\ f(X\cap\ ]-\infty,-M[)\subset B(A,\varepsilon).
\]

从几何意义上来看，\(\lim_{x\to+\infty}f(x)=A\)（\(\lim_{x\to-\infty}f(x)=A\)）表明对任意小的 \(\varepsilon>0\)，总可以找到一个 \(M>0\)，使得 \(f\) 在 \(X\cap\ ]M,+\infty[\)（\(X\cap\ ]-\infty,-M[\)）上的限制的图形完全位于平面带形区域 \(]M,+\infty[\times]A-\varepsilon,A+\varepsilon[\)（\(]-\infty,-M[\times]A-\varepsilon,A+\varepsilon[\)）内（如\rfig{fig:4-5}所示）。

\begin{figure}[htbp]
	\centering
	\includegraphics[
	width=.82\linewidth,
	height=.72\textheight,
	keepaspectratio
	]{_page_143_Figure_0.jpeg}
	\caption{}
	\label{fig:4-5}
\end{figure}

\begin{sourceexample}{6}

	考虑函数 \(x\mapsto\dfrac1{x^2},\ x\in\R-\{0\}\)。证明：
	\[
	\lim_{x\to+\infty}\frac1{x^2}=\lim_{x\to-\infty}\frac1{x^2}=0.
	\]

	事实上，\(\forall\,\varepsilon>0\)，由 \(\left|\dfrac1{x^2}-0\right|=\dfrac1{x^2}<\varepsilon\) 得到 \(|x|>\dfrac1{\sqrt{\varepsilon}}\)。若令 \(M=\dfrac1{\sqrt{\varepsilon}}\)，则
	\[
	\left.\begin{array}{l} \forall\,x\in\ ]M,+\infty[ \\[2pt] \forall\,x\in\ ]-\infty,-M[ \end{array}\right\}\Longrightarrow \left|\frac1{x^2}-0\right|<\varepsilon.
	\]
	因此 \(\lim_{x\to+\infty}\dfrac1{x^2}=0,\ \lim_{x\to-\infty}\dfrac1{x^2}=0\)。

\end{sourceexample}

\begin{sourceexample}{7}

	考虑函数 \(x\mapsto\cos\dfrac1x,\ x\in\R-\{0\}\)。证明：
	\[
	\lim_{x\to+\infty}\cos\frac1x=\lim_{x\to-\infty}\cos\frac1x=1.
	\]

	事实上，由于 \(\forall\,x\in\R,\ |\sin x|\le|x|\)，故 \(\forall\,x\in\R-\{0\}\)，
	\[
	\left|\cos\frac1x-1\right|=\left|2\sin^2\frac1{2x}\right|\le2\cdot\frac1{4x^2}=\frac1{2x^2}.
	\]
	因此，\(\forall\,\varepsilon>0\)，由 \(\dfrac1{2x^2}<\varepsilon\) 得到 \(|x|>\dfrac1{\sqrt{2\varepsilon}}\)。若令 \(M=\dfrac1{\sqrt{2\varepsilon}}\)，则
	\[
	\left.\begin{array}{l} \forall\,x\in\ ]M,+\infty[ \\[2pt] \forall\,x\in\ ]-\infty,-M[ \end{array}\right\}\Longrightarrow \left|\cos\frac1x-1\right|<\varepsilon.
	\]
	因此 \(\lim_{x\to+\infty}\cos\dfrac1x=1,\ \lim_{x\to-\infty}\cos\dfrac1x=1\)。

\end{sourceexample}

\begin{sourceexample}{8}

	考虑函数 \(x\mapsto\dfrac{x^2-1}{2(x^2+x-2)},\ x\in\R-\{1,-2\}\)。证明：
	\[
	\lim_{x\to+\infty}\frac{x^2-1}{2(x^2+x-2)}=\lim_{x\to-\infty}\frac{x^2-1}{2(x^2+x-2)}=\frac12.
	\]

	事实上，由于 \(\forall\,x\neq1,-2\)，我们有
	\[
	\left|\frac{x^2-1}{2(x^2+x-2)}-\frac12\right|=\left|\frac{-2(x-1)}{2(x-1)(x+2)}\right|=\frac1{|x+2|}.
	\]
	故若首先限制 \(|x|>2\)，则 \(\forall\,\varepsilon>0\)，由 \(\dfrac1{|x+2|}\le\dfrac1{|x|-2}<\varepsilon\) 得到
	\[
	|x|>2+\frac1\varepsilon.
	\]
	令 \(M=2+\dfrac1\varepsilon\)，则
	\[
	\left.\begin{array}{l} \forall\,x\in\ ]M,+\infty[ \\[2pt] \forall\,x\in\ ]-\infty,-M[ \end{array}\right\}\Longrightarrow \left|\frac{x^2-1}{2(x^2+x-2)}-\frac12\right|<\varepsilon.
	\]
	因此 \(\lim_{x\to+\infty}\dfrac{x^2-1}{2(x^2+x-2)}=\dfrac12,\ \lim_{x\to-\infty}\dfrac{x^2-1}{2(x^2+x-2)}=\dfrac12\)。

\end{sourceexample}

\begin{sourceexample}{9}

	考虑函数 \(x\mapsto\sin x,\ x\in\R\)。证明 \(\lim_{x\to+\infty}\sin x\) 不存在。

	事实上，如果存在 \(A\in\R\) 使得 \(\lim_{x\to+\infty}\sin x=A\)，则
	\[
	(\forall\,0<\varepsilon<1)(\exists\,M>0)(\forall\,x\in\ ]M,+\infty[)\Longrightarrow|\sin x-A|<\varepsilon.
	\]
	于是对 \(n\) 充分大，\(2n\pi-\dfrac\pi2,\ 2n\pi+\dfrac\pi2>M\)。从而
	\[
	\left|\sin\left(2n\pi-\frac\pi2\right)-A\right|=|(-1)-A|<\varepsilon,
	\]
	\[
	\left|\sin\left(2n\pi+\frac\pi2\right)-A\right|=|1-A|<\varepsilon.
	\]
	由此推得
	\[
	2=|1-(-1)|=|1-A+A-(-1)|\le|1-A|+|A-(-1)|<2\varepsilon.
	\]
	于是 \(\varepsilon>1\)，这与 \(0<\varepsilon<1\) 假设相矛盾。因此 \(\lim_{x\to+\infty}\sin x\) 不存在。

\end{sourceexample}

\subsection*{习 题}

\begin{exercise}
	\item 用极限定义证明下列各极限：
	\begin{enumerate}[label=\arabic*)]
		\item \(\lim_{x\to0}x\sin\dfrac1x=0\)，\quad \(\lim_{x\to a}\sqrt[n]{x}=\sqrt[n]{a}\)（\(a>0,\ n\in\N\)）；
		\item \(\lim_{x\to1}(3x^3-2)=1\)，\quad \(\lim_{x\to3}(2x^2-x)=15\)；
		\item \(\lim_{x\to\pm\infty}\dfrac{[x]}{x}=1\)，\quad \(\lim_{x\to\pm\infty}\dfrac{2x^2-1}{3x^2-x}=\dfrac23\)；
		\item \(\lim_{x\to\pm\infty}\dfrac{3x^2-1}{x^2+x+1}=3\)，\quad \(\lim_{x\to\pm\infty}(\sqrt{x^2+x}-x)=\dfrac12\)。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 证明：极限 \(\lim_{x\to0}\dfrac1x\) 不存在。
\end{exercise}

\begin{exercise}
	\item 证明：若 \(\lim_{x\to a}f(x)=A\)，则 \(\lim_{x\to a}|f(x)|=|A|\)，这里 \(a\in\R\) 或 \(a=\pm\infty\)。
\end{exercise}

\begin{exercise}
	\item 设函数 \(x\longmapsto x-[x],\ x\in\R\)。
	\begin{enumerate}[label=\arabic*)]
		\item 证明：\(\forall\,n\in\Z,\ \lim_{x\to n}(x-[x])\) 不存在；
		\item 证明：\(\forall\,a\notin\Z,\ \lim_{x\to a}(x-[x])\) 存在。
	\end{enumerate}
\end{exercise}

\begin{exercise}
	\item 设 \(f:\R\to\R\) 是以 \(T\) 为周期的周期函数。证明：若 \(\lim_{x\to+\infty}f(x)=A\)，则 \(f(x)\equiv A,\ \forall\,x\in\R\)。
\end{exercise}

\begin{exercise}
	\item 对函数
	\[
	x\longmapsto f(x)=\begin{cases} x, & \text{若 }x\in\Q, \\ -x, & \text{若 }x\in\Q^c, \end{cases}
	\]
	证明：\(\lim_{x\to0}f(x)=0\)；\(\forall\,a\neq0,\ \lim_{x\to a}f(x)\) 不存在。
\end{exercise}

\begin{exercise}
	\item 设 \([a,b]\) 是任一有限闭区间。假设 \(\forall\,x_0\in[a,b]\)，极限 \(\lim_{x\to x_0}f(x)\) 存在。试用两种不同的方法证明：存在 \(M>0\)，使得 \(\forall\,x\in[a,b],\ |f(x)|\le M\)。
\end{exercise}

\begin{exercise}
	\item 设 \(P_n(x)=a_nx^n+a_{n-1}x^{n-1}+\cdots+a_1x+a_0\)，其中 \(n\ge1,\ a_n\neq0\)。试用极限定义证明 \(\lim_{x\to\pm\infty}|P_n(x)|=+\infty\)。
\end{exercise}



\section{函数极限的性质}

函数极限的性质与收敛序列极限的大多数性质是类似的。这里我们只对 \((a,A)\) 型的函数极限性质进行叙述和证明。对于 \((\pm\infty,A)\) 型的情形，读者可仿照 \((a,A)\) 型的性质自己去论述。

\subsection{函数极限的一般性质}

\begin{myproperty}{}{func-limit-uniqueness}
	如果函数 \(f:X\to\R\) 当 \(x\to a\) 时有极限存在，则极限是唯一的。
\end{myproperty}

\begin{proof}
	设 \(\lim_{x\to a}f(x)=A\)，\(\lim_{x\to a}f(x)=A'\) 并且 \(A\neq A'\)。那末由 \(\R\) 的 Hausdorff 分离性知，存在 \(\varepsilon_0>0\) 使得
	\[
	B(A,\varepsilon_0)\cap B(A',\varepsilon_0)=\varnothing.
	\]
	另一方面，对于 \(\varepsilon_0>0\)，存在 \(\delta_1>0,\delta_2>0\) 使得
	\[
	f(X\cap\mathring{B}(a,\delta_1))\subset B(A,\varepsilon_0),
	\]
	\[
	f(X\cap\mathring{B}(a,\delta_2))\subset B(A',\varepsilon_0).
	\]
	令 \(\delta=\min(\delta_1,\delta_2)\)，则 \(\delta>0\)，并且
	\[
	f(X\cap\mathring{B}(a,\delta))\subset B(A,\varepsilon_0)\cap B(A',\varepsilon_0).
	\]
	于是 \(f(X\cap\mathring{B}(a,\delta))=\varnothing\)，这与 \(a\) 为 \(X\) 的聚点相矛盾，因此 \(A=A'\)。
\end{proof}

\begin{myproperty}{}{func-limit-local-boundedness}
	若 \(\lim_{x\to a}f(x)=A\)，则 \(f\) 在 \(a\) 处是局部有界的。即
	\[
	(\exists\,M>0)(\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow |f(x)|\le M.
	\]
\end{myproperty}

\begin{proof}
	因为 \(\lim_{x\to a}f(x)=A\)，所以由定义，对 \(\varepsilon=1>0\)，存在 \(\delta>0\)，使得
	\[
	\forall\,x\in X\cap\mathring{B}(a,\delta)\Longrightarrow |f(x)-A|<1
	\]
	\[
	\Longrightarrow |f(x)|\le|A|+|f(x)-A|
	\]
	\[
	<|A|+1.
	\]
	取 \(M=1+|A|\) 即可。
\end{proof}

\begin{myproperty}{Cauchy收敛准则}{func-limit-cauchy}
	函数 \(f:X\to\R\) 当 \(x\) 趋于 \(a\) 时极限存在的充分必要条件是：
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta>0)(\forall\,x,x'\in X\cap\mathring{B}(a,\delta))\Longrightarrow |f(x)-f(x')|<\varepsilon.
	\]
\end{myproperty}

\begin{proof}
	必要性\quad 设 \(\lim_{x\to a}f(x)=A\)。由定义有
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta>0)(\forall\,x,x'\in X\cap\mathring{B}(a,\delta))
	\]
	\[
	\Longrightarrow |f(x)-A|<\varepsilon/2,\quad |f(x')-A|<\varepsilon/2
	\]
	\[
	\Longrightarrow |f(x)-f(x')|\le|f(x)-A|+|A-f(x')|
	\]
	\[
	<\varepsilon/2+\varepsilon/2=\varepsilon.
	\]

	充分性\quad 假设条件满足，即
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta>0)(\forall\,x,x'\in X\cap\mathring{B}(a,\delta))
	\]
	\[
	\Longrightarrow |f(x)-f(x')|<\varepsilon.
	\]
	证明分两步进行。

	\(1^\circ\) 证明：存在一个收敛的实数序列 \(\langle f(x_n)\rangle\)。

	因为 \(a\in\R\) 是 \(X\) 的聚点，所以 \(\forall\,n\in\N,\ X\cap\mathring{B}(a,\frac1n)\neq\varnothing\)。任取 \(x_n\in X\cap\mathring{B}(a,\frac1n)\ (n\in\N)\)。于是我们得到一实数序列 \(\langle f(x_n)\rangle\)。

	由于 \(\lim_{n\to+\infty}\frac1n=0\)，故对 \(\delta>0\) 存在 \(N\in\N\) 使得
	\[
	\forall\,n,m\in\N,\ n,m\ge N\Longrightarrow \frac1n\le\frac1N<\delta,\quad \frac1m\le\frac1N<\delta.
	\]
	于是
	\[
	\forall\,n,m\in\N,\ n,m\ge N\Longrightarrow x_n,x_m\in X\cap\mathring{B}(a,\frac1N)
	\]
	\[
	\subset X\cap\mathring{B}(a,\delta)
	\]
	\[
	\Longrightarrow |f(x_n)-f(x_m)|<\varepsilon.
	\]
	此即表明 \(\langle f(x_n)\rangle\) 是 Cauchy 实数序列。由 \(\R\) 的完备性知 \(\langle f(x_n)\rangle\) 收敛，令 \(\lim_{n\to+\infty}f(x_n)=A\)。

	\(2^\circ\) 证明：\(\lim_{x\to a}f(x)=A\)。

	因为 \(\lim_{n\to+\infty}f(x_n)=A\)，所以由定义
	\[
	(\forall\,\varepsilon>0)(\exists\,N\in\N)(\forall\,n\in\N,\ n\ge N)\Longrightarrow |f(x_n)-A|<\varepsilon.
	\]
	于是由已知条件及 \(\forall\,n\in\N,\ n\ge N,\ x_n\in X\cap\mathring{B}(a,\delta)\) 知，
	\[
	\forall\,x\in X\cap\mathring{B}(a,\delta)\Longrightarrow |f(x)-f(x_n)|<\varepsilon
	\]
	\[
	\Longrightarrow |f(x)-A|\le|f(x)-f(x_n)|+|f(x_n)-A|<\varepsilon+\varepsilon=2\varepsilon.
	\]
	因此 \(\lim_{x\to a}f(x)=A\)。
\end{proof}

反映函数极限与序列极限之间联系的是下面的重要定理。

\begin{myproperty}{Heine定理}{func-limit-heine}
	函数 \(f:X\to\R\) 当 \(x\) 趋于 \(a\) 时有极限 \(A\) 的充分必要条件是：
	\[
	\forall\,x_n\in X-\{a\}\ (n\in\N)\ \text{且}\ x_n\to a\ (n\to+\infty),\ \lim_{n\to+\infty}f(x_n)=A.
	\]
\end{myproperty}

\begin{proof}
	必要性\quad 设 \(\lim_{x\to a}f(x)=A\)。\(x_n\in X-\{a\}\)，并且 \(x_n\to a\ (n\to+\infty)\)。由定义
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow |f(x)-A|<\varepsilon.
	\]
	\[
	(\forall\,\delta>0)(\exists\,N\in\N)(\forall\,n\in\N,\ n\ge N)\Longrightarrow x_n\in\mathring{B}(a,\delta).
	\]
	从而
	\[
	\forall\,n\in\N,\ n\ge N\Longrightarrow |f(x_n)-A|<\varepsilon.
	\]
	因此 \(\lim_{n\to+\infty}f(x_n)=A\)。

	充分性\quad 假设条件成立，即
	\[
	\forall\,x_n\in X-\{a\}\ (n\in\N),\ x_n\to a\ (n\to+\infty),\ \text{则}\ \lim_{n\to+\infty}f(x_n)=A.
	\]
	我们用反证法证明。假设 \(\lim_{x\to a}f(x)\neq A\)，则
	\[
	(\exists\,\varepsilon_0>0)(\forall\,n\in\N)(\exists\,x_n\in X\cap\mathring{B}(a,\tfrac1n))
	\]
	\[
	\Longrightarrow |f(x_n)-A|\ge\varepsilon_0. \tag{*}
	\]
	由此得一实数序列 \(\langle x_n\rangle\)，它满足：\(x_n\in X-\{a\}\)，\(x_n\to a\ (n\to+\infty)\)。于是 \(\lim_{n\to+\infty}f(x_n)=A\)，在 \((*)\) 式中令 \(n\to+\infty\) 得到 \(\varepsilon_0\le0\)。这与 \(\varepsilon_0>0\) 矛盾，故必有 \(\lim_{x\to a}f(x)=A\)。
\end{proof}

\begin{sourceexample}{1}

	考虑函数 \(x\mapsto\sin\dfrac1x,\ x\in\R-\{0\}\) 及 \(x\mapsto\sin x,\ x\in\R\)。利用 Heine 定理证明：
	\[
	\text{1) } \lim_{x\to0}\sin\frac1x \text{ 不存在，}\qquad \text{2) } \lim_{x\to\pm\infty}\sin x \text{ 不存在}.
	\]
	为此，1) 取 \(x_n=\dfrac1{2n\pi}\)，\(x_n'=\dfrac1{2n\pi+\frac\pi2}\ (n\in\N)\)。则 \(x_n,x_n'\in\R-\{0\}\ (\forall\,n\in\N)\)，并且 \(x_n\to0,\ x_n'\to0\ (n\to+\infty)\) 但是
	\[
	\lim_{n\to+\infty}\sin\frac1{x_n}=0,\qquad \lim_{n\to+\infty}\sin\frac1{x_n'}=1.
	\]
	因此由 Heine 定理知，\(\lim_{x\to0}\sin\dfrac1x\) 不存在。

	2) 取 \(x_n=2n\pi\)，\(x_n'=2n\pi+\dfrac\pi2\ (n\in\N)\)，则 \(x_n\to+\infty,\ x_n'\to+\infty\ (n\to+\infty)\)。由于
	\[
	\sin x_n=0,\qquad \sin x_n'=1,
	\]
	故由 Heine 定理知，\(\lim_{x\to+\infty}\sin x\) 不存在。

\end{sourceexample}

