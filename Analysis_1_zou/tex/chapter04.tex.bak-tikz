\subsection{函数极限的不等式性质}

\begin{myproperty}{}{func-limit-eventual-order}
	若 \(\lim_{x\to a}f(x)=A>r\ (<r)\)，则
	\[
	(\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow f(x)>r\ (<r).
	\]
\end{myproperty}

\begin{proof}
	我们只对 \(A>r\) 的情形证明。由于 \(\lim_{x\to a}f(x)=A>r\)，故对 \(\varepsilon=\dfrac{A-r}2>0\)，存在 \(\delta>0\) 使得
	\[
	\forall\,x\in X\cap\mathring{B}(a,\delta)\Longrightarrow |f(x)-A|<\frac{A-r}2
	\]
	\[
	\Longrightarrow f(x)>A-\frac{A-r}2=\frac{A+r}2>r.
	\]
\end{proof}

\begin{myproperty}{}{func-limit-strict-comparison}
	设 \(f,g\) 是任意两个函数，\(X=\operatorname{Dom}(f)\cap\operatorname{Dom}(g)\neq\varnothing\)，\(a\in\R\) 是 \(X\) 的聚点，并且
	\begin{enumerate}[label=\arabic*)]
		\item \(\lim_{x\to a}f(x)=A,\ \lim_{x\to a}g(x)=B\)；
		\item \(A>B\ (A<B)\)，
	\end{enumerate}
	则
	\[
	(\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow f(x)>g(x)\ (f(x)<g(x)).
	\]
\end{myproperty}

\begin{proof}
	我们只对 \(A>B\) 的情形证明。令 \(r=\dfrac{A+B}2\)，则由 \(\lim_{x\to a}f(x)=A>r>B=\lim_{x\to a}g(x)\) 及\rprop{property:func-limit-eventual-order}知
	\[
	(\exists\,\delta_1>0)(\forall\,x\in X\cap\mathring{B}(a,\delta_1))\Longrightarrow f(x)>r,
	\]
	\[
	(\exists\,\delta_2>0)(\forall\,x\in X\cap\mathring{B}(a,\delta_2))\Longrightarrow g(x)<r.
	\]
	令 \(\delta=\min(\delta_1,\delta_2)\)，则
	\[
	\forall\,x\in X\cap\mathring{B}(a,\delta)\Longrightarrow f(x)>g(x).
	\]
\end{proof}

\begin{myproperty}{}{func-limit-preserves-order}
	设 \(f,g\) 是任意两个函数，\(X=\operatorname{Dom}(f)\cap\operatorname{Dom}(g)\neq\varnothing\)，\(a\in\R\) 是 \(X\) 的聚点，并且
	\begin{enumerate}[label=\arabic*)]
		\item \(\lim_{x\to a}f(x)=A,\ \lim_{x\to a}g(x)=B\)；
		\item \((\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow f(x)\ge g(x)\ (f(x)\le g(x))\)，
	\end{enumerate}
	则
	\[
	A\ge B\ (A\le B).
	\]
\end{myproperty}

\begin{proof}
	用反证法，由\rprop{property:func-limit-strict-comparison}立即推出。
\end{proof}

\textbf{附注}\quad 在条件 2) 中即使把 \(f(x)\ge g(x)\ (f(x)\le g(x))\) 换成严格不等式 \(f(x)>g(x)\ (f(x)<g(x))\)，也不一定有 \(A>B\ (A<B)\)。例如函数 \(x\mapsto2x^2,\ x\in\R-\{0\}\) 与 \(x\mapsto x^2,\ x\in\R-\{0\}\)，显然有 \(2x^2>x^2\ (\forall\,x\in\R-\{0\})\)，但 \(\lim_{x\to0}2x^2=\lim_{x\to0}x^2=0\)。

\begin{myproperty}{}{func-limit-squeeze}
	设 \(f,g,h\) 是任意三个函数，\(X=\operatorname{Dom}(f)\cap\operatorname{Dom}(g)\cap\operatorname{Dom}(h)\neq\varnothing\)，\(a\in\R\) 是 \(X\) 的聚点，并且
	\begin{enumerate}[label=\arabic*)]
		\item \((\exists\,\delta>0)(\forall\,x\in X\cap\mathring{B}(a,\delta))\Longrightarrow f(x)\le h(x)\le g(x)\)；
		\item \(\lim_{x\to a}f(x)=\lim_{x\to a}g(x)=A\)，
	\end{enumerate}
	则
	\[
	\lim_{x\to a}h(x)=A.
	\]
\end{myproperty}

\begin{proof}
	因为 \(\lim_{x\to a}f(x)=\lim_{x\to a}g(x)=A\)，所以由定义
	\[
	(\forall\,\varepsilon>0)(\exists\,\delta'>0)(\forall\,x\in X\cap\mathring{B}(a,\delta'))
	\]
	\[
	\Longrightarrow |f(x)-A|<\varepsilon,\quad |g(x)-A|<\varepsilon
	\]
	\[
	\Longrightarrow A-\varepsilon<f(x),\ g(x)<A+\varepsilon.
	\]
	令 \(\eta=\min(\delta,\delta')\)，则由上述不等式及条件 1) 推得
	\[
	\forall\,x\in X\cap\mathring{B}(a,\eta)\Longrightarrow A-\varepsilon<h(x)<A+\varepsilon
	\]
	\[
	\Longrightarrow |h(x)-A|<\varepsilon.
	\]
	因此 \(\lim_{x\to a}h(x)=A\)。
\end{proof}

\begin{sourceexample}{3}

	证明：\(\lim_{x\to0}\dfrac{\sin x}{x}=1\)。

	首先设 \(0<x<\dfrac\pi2\)。如\rfig{fig:4-8}所示，\(A,B\) 是单位圆周上两点，使得 \(\angle AOB=x\)，则由图形可知
	三角形 \(AOB\) 的面积 \(S_1=\dfrac12\cdot1\cdot\sin x\)，
	扇形 \(AOB\) 的面积 \(S_2=\dfrac12\cdot1\cdot x\)，
	三角形 \(AOC\) 的面积 \(S_3=\dfrac12\cdot1\cdot\operatorname{tg}x\)，
	并且 \(S_1<S_2<S_3\)。由此得到不等式
	\[
	\sin x<x<\operatorname{tg}x.
	\]
	两边同除以 \(\sin x\neq0\)，得 \(1<\dfrac{x}{\sin x}<\dfrac1{\cos x}\) 或
	\[
	\cos x<\frac{\sin x}{x}<1\quad\left(0<x<\frac\pi2\right).
	\]
	现设 \(-\dfrac\pi2<x<0\)，则 \(0<(-x)<\dfrac\pi2\)，代入上式得
	\[
	\cos(-x)<\frac{\sin(-x)}{(-x)}<1,
	\]
	或
	\[
	\cos x<\frac{\sin x}{x}<1.
	\]
	因此我们有下述不等式：
	\[
	\cos x<\frac{\sin x}{x}<1,\quad \forall\,x\in\left]-\frac\pi2,\frac\pi2\right[\setminus\{0\}.
	\]
	易证 \(\lim_{x\to0}\cos x=1\)，故由\rprop{property:func-limit-squeeze}立即推得
	\[
	\lim_{x\to0}\frac{\sin x}{x}=1.
	\]

\end{sourceexample}

